30\ub2f9\ub960\ud45c\uc5d0\ub294 \ucfe0\ud3f0\uc0dd\uc131 \ub2f9\uc2dc \uc720\ud6a8\ud55c \ud3c9\uade0 \ubc30\ub2f9\ub960\uc774 \ud45c\uc2dc\ub429\ub2c8\ub2e4. \uc5c5\ub370\uc774\ud2b8\ud558\uc2dc\ub824\uba74 \ud604\uc7ac \ubc30\ub2f9\ub960\uc744 \ud074\ub9ad\ud558\uc138\uc694.\",QU=\"\uc544\uc9c1 \uacf5\uac1c \ucfe0\ud3f0\uc744 \uc0dd\uc131\ud558\uc9c0 \uc54a\uc73c\uc168\uc2b5\ub2c8\ub2e4. \ucfe0\ud3f0\uc5d0 \uacbd\uae30\ub97c \ucd94\uac00\ud55c \ud6c4 \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uacfc \uacf5\uc720\ud558\uc138\uc694.\",GU=\"\ub4f1\ub85d\",WU=\"\ub85c\uadf8\uc778\",VU=\"\uacf5\uac1c \ucfe0\ud3f0\uc744 \uc0dd\uc131\ud558\uace0 \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uacfc \uacf5\uc720\ud558\ub824\uba74.\",qU=\"\uad11\uace0\",YU=\"\ubcf4\ub108\uc2a4 \ud61c\ud0dd\",JU=\"\ubaa8\ub4e0 \ubcf4\ub108\uc2a4 \ud61c\ud0dd\",ZU=\"\ub274\uc2a4\",KU=\"\ubaa8\ub4e0 \ub274\uc2a4\",XU=\"\uadc0\ud558\uc758 \uacc4\uc815\uacfc \uc624\uc988\ud3ec\ud0c8\uc744\",eF=\"\uadc0\ud558\uc758 \ud544\uc694\uc5d0 \ub9de\uac8c \uc870\uc808\ud558\uc138\uc694!\",tF=\"\ub9ac\uc18c\uc2a4\",oF=\"\uad8c\uc7a5 \ub9ac\uc18c\uc2a4 \ubaa9\ub85d\uc5d0\uc11c \uc628\ub77c\uc778 \ubca0\ud305, \ubc30\ub2f9\ub960 \ube44\uad50 \ub610\ub294\",nF=\"\uc2a4\ud3ec\uce20 \uad00\ub828 \ub2e4\ub978 \uc0ac\uc774\ud2b8\ub97c \ucc3e\uc544\ubcf4\uc138\uc694\",sF=\"\ub9ac\ubdf0\",aF=\"\ud544\ud130\",rF=\"\uc5b8\uc5b4\",iF=\"\uc785\uae08 \ubc29\ubc95\",cF=\"\ucd9c\uae08 \ubc29\ubc95\",lF=\"\ud1b5\ud654\",_F=\"\ud3c9\uade0 \uc9c0\ubd88\uc561\",dF=\"\ud658\uc601 \ubcf4\ub108\uc2a4\",uF=\"\ubaa8\ubc14\uc77c \ubca0\ud305\",pF=\"\ub354 \ub9ce\uc740 \uc635\uc158\",mF=\"\uac80\uc0c9\",fF=\"\ub9c8\uc774 \ubd81\uba54\uc774\ucee4\",gF=\"\uc77c\ubc18 \uc124\uc815\",hF=\"\ub9c8\uc774 \ub9ac\uadf8\",yF=\"\ub9c8\uc774 \ubd81\uba54\uc774\ucee4\",bF=\"\ucee4\ubba4\ub2c8\ud2f0 \ud53c\ub4dc \uc544\uc774\ud15c \ud398\uc774\uc9c0 \ucf58\ud150\uce20 \ub798\ud37c \uad6c\uc131\uc694\uc18c\",vF=\"\uc544\ub798 \ud56d\ubaa9\uc744 \ubaa8\ub450 \uc791\uc131\ud558\uc138\uc694. \uc774\uba54\uc77c\uc758 \uac12\uc744 \uc785\ub825\ud558 \ud655\uc778\uc744 \ub20c\ub7ec \ud68c\uc6d0\uac00\uc785\uc744 \uc644\ub8cc\ud558\uc138\uc694\",wF=\"\uc0ac\uc6a9\uc790 \uc774\ub984\",CF=\"\ucf54\ub4dc\",AF=\"\ud655\uc778\",kF=\"\uc0c8 \uacc4\uc815 \uc0dd\uc131\",IF=\"\ud398\uc774\uc2a4\ubd81\uc73c\ub85c \ub85c\uadf8\uc778\",TF=\"\uc560\ud50c\ub85c \ub85c\uadf8\uc778\",xF=\"\uad6c\uae00\ub85c \ub85c\uadf8\uc778\",EF=\"\ube44\ubc00\ubc88\ud638\",SF=\"\uc774\uba54\uc77c\",PF=\"\uad6d\uac00\",OF=\"\ub3d9\uc758\",$F=\"\uadf8\ub9ac\uace0\",NF=\"\ub0b4 \uacc4\uc815 \ub9cc\ub4e4\uae30\",zF=\"\uc0c1\uae08\",jF=\"\ub354 \ubcf4\uae30\",MF=\"\ubc30\ub2f9\ub960 \ud615\uc2dd\",LF=\"\uc2dc\uac04 \ud615\uc2dd\",BF=\"\ucd5c\uc2e0 \ubc30\ub2f9\ub960\uc744 \ud655\uc778\ud558\uace0 \ube44\uad50\ud558\uc138\uc694\",RF=\"\uc624\uc988\ud3ec\ud0c8 - \ubc30\ub2f9\ub960 \ubaa8\ub2c8\ud130\ub9c1\",DF=\"60\uac1c \uc774\uc0c1 \uc8fc\uc694 \ubd81\uba54\uc774\ucee4\ub4e4\uc758 \ubc30\ub2f9\ub960\",HF=\"\ud604\uc7ac\uc758 \ub9c8\ucf13\ud750\ub984\uc744 \ucd94\uc801\ud558\uc138\uc694\",UF=\"\ud558\ub77d \ubc30\ub2f9\ub960\",FF=\"\ucc28\ub2e8 \ubc30\ub2f9\ub960\",QF=\"\uacbd\uae30\uc911 \ubca0\ud305\",GF=\"\uacbd\uae30\uc911 \ubc30\ub2f9\ub960\",WF=\"\uacbd\uae30\uc911 \ubc30\ub2f9\ub960\",VF=\"\ucfe0\ud3f0\uc744 \uc0dd\uc131\ud558\uace0 \uba40\ud2f0\ubca0\ud305\uc5d0\uc11c \ucd5c\uace0\uc758 \ubc30\ub2f9\ub960\uc744 \uc81c\uacf5\ud558\ub294\",qF=\"\ubd81\uba54\uc774\ucee4\ub97c \ucc3e\uc73c\uc138\uc694\",YF=\"\uc6d0\uaca9 \ubca0\ud305\uc804\ud45c\ub97c \uc774\uc6a9\ud558\uc5ec\",JF=\"\uc6d0\ud074\ub9ad \ubca0\ud305\uc758\",ZF=\"\uc774\uc810\uc744 \uc990\uae30\uc138\uc694\",KF=\"\uc774 \uba54\uc2dc\uc9c0\ub97c \uc228\uae30\ub824\uba74, \ubd81\uba54\uc774\ucee4\ub97c \ub9de\ucda4\uc124\uc815\ud558\uace0 \uae30\ud0c0 \uc5ec\ub7ec \uc124\uc815\uc5d0 \uc811\uadfc\ud558\uc138\uc694\",XF=\"\ubb34\ub8cc \ud68c\uc6d0\uac00\uc785\",eQ=\"\ube44\ubc00\ubc88\ud638 \ubd84\uc2e4\",tQ=\"\uc0c8 \ube44\ubc00\ubc88\ud638\",oQ=\"\ube44\ubc00\ubc88\ud638 \ud655\uc778\",nQ=\"\ube44\ubc00\ubc88\ud638 \ubd84\uc2e4\uc744 \ubcf5\uad6c\ud558\ub824\uba74 \uc774\uba54\uc77c\uc744 \ucc44\uc6b0\uc138\uc694. \ucd94\uac00 \uc815\ubcf4\uac00 \uadc0\ud558\uc758 \uc774\uba54\uc77c\ub85c \uc804\uc1a1\ub429\ub2c8\ub2e4.\",sQ=\"\ud65c\uc131\ud654 \uc774\uba54\uc77c \ub2e4\uc2dc \ubcf4\ub0b4\uae30\",aQ=\"\uc804\uccb4\",rQ=\"\uc990\uaca8\ucc3e\uae30\",iQ=\"\uc774\uc804 \ube44\ubc00\ubc88\ud638\",cQ=\"\uae30\ubcf8 '\ub9c8\uc774 \ub9e4\uce58' \ud45c\uc2dc\",lQ=\"\uc544\ub2c8\uc624\",_Q=\"\uc608\",dQ=\"\uc8fc\ub85c \ud648\ud398\uc774\uc9c0\uc640 \ub2e4\uc74c \uacbd\uae30 \uc139\uc158\uc5d0 '\ub9c8\uc774 \ub9e4\uce58' \ud0ed\uc774 \ud45c\uc2dc\ub429\ub2c8\ub2e4.\",uQ=\"\uacbd\uae30 \uc815\ub82c\",pQ=\"\ud0a5\uc624\ud504 \ud0c0\uc784\",mQ=\"\uae30\ubcf8 \ubc30\ub2f9\ub960 \ud615\uc2dd\",fQ='\ubc30\ub2f9\ub960\uc740 \uc8fc\ub85c \uacbd\uae30\uc0c1\uc138\uc5d0 \ud45c\uc2dc\ub429\ub2c8\ub2e4. \ud2b9\uc815 \uc885\ubaa9\uc758 \uac00\uc7a5 \uc77c\ubc18\uc801\uc778 \ubca0\ud305\uc720\ud615\uc744 \ubcf4\uc2dc\ud600\uba74 \"\uc885\ubaa9 \uae30\ubcf8\uac12\"\uc744 \uc120\ud0dd\ud558\uc138\uc694.',gQ=\"\uc120\ud638 \ubc30\ub2f9\ub960 \uac12\",hQ=\"\ud3c9\uade0\",yQ=\"\ucd5c\ub300\",bQ=\"\ubca0\ud305 \uac70\ub798\uc218\uc218\ub8cc \uc124\uc815\",vQ=\"\ubca0\ud305 \uac70\ub798\uc5d0 \ub300\ud55c LAY \ubc30\ub2f9\ub960 \uc228\uae30\uae30\",wQ=\"\uc790\ub3d9 \uacf5\uc81c\",CQ=\"\ud45c\uc900 \uac70\ub798\uc218\uc218\ub8cc?:\",AQ=\"\uc800\uc7a5\",kQ=\"\uc608\uce21\",IQ=\"\uc608\uce21\",TQ=\"\uc0ac\uc6a9\uc790\",xQ=\"\ud314\ub85c\uc6cc\",EQ=\"\ubb38\uc758\ud558\uae30\",SQ=\"\ubb38\uc758\ud558\uae30\",PQ=\"\uc774\ub984\",OQ=\"\uc81c\ubaa9\",$Q=\"\uba54\uc2dc\uc9c0\",NQ=\"\ucca8\ubd80\ud30c\uc77c\",zQ=\"\uc5ec\uae30\uc5d0 \ud30c\uc77c\uc744 \ub193\uac70\ub098\",jQ=\"\ub514\ubc14\uc774\uc2a4\uc5d0\uc11c \ud30c\uc77c\uc744 \uc120\ud0dd\ud558\uc138\uc694\",MQ=\"\ucc98\ub9ac\uc5d0 \ub3d9\uc758\ud569\ub2c8\ub2e4\",LQ=\"\uac1c\uc778\uc815\ubcf4\",BQ=\"\uac1c\uc778\uc815\ubcf4\ucc98\ub9ac\uc5d0 \ub3d9\uc758\ud558\uc154\uc57c \ud569\ub2c8\ub2e4.\",RQ=\"\uba54\uc2dc\uc9c0 \uc804\uc1a1\",DQ=\"\uc5d0\ub7ec \ud398\uc774\uc9c0\",HQ=\"\ud53c\ub4dc\ub85c \ub3cc\uc544\uac00\uae30\",UQ=\"SNS \ub85c\uadf8\uc778\",FQ=\"\uac10\uc0ac\ud569\ub2c8\ub2e4!\",QQ=\"\uacc4\uc815\uc774 \ud655\uc778\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ub85c\uadf8\uc778 \ud6c4 \uc624\uc988\ud3ec\ud0c8\ub2f7\ucef4\uc744 \uc774\uc6a9\ud558\uc138\uc694.\",GQ=\"\ub85c\uadf8\uc778\",WQ=\"\ub098\ub97c \uae30\uc5b5\ud558\uae30\",VQ=\"\uc9c0\uae08 \ubb34\ub8cc\ub85c \uc0dd\uc131\ud558\uc138\uc694!\",qQ=\"\ube44\ubc00\ubc88\ud638 \ubd84\uc2e4\",YQ=\"\ube44\ubc00\ubc88\ud638\ub97c \ubcf5\uad6c\ud558\uc2dc\ub824\uba74 \uc774\uba54\uc77c\uc744 \uc785\ub825\ud558\uc138\uc694.\",JQ=\"\uc720\uc9c0\ubcf4\uc218 \ud398\uc774\uc9c0\",ZQ=\"\uc0c1\ud0dc\",KQ=\"\ud574\ub2f9 \uc0ac\uc6a9\uc790\uc758 \ud504\ub85c\ud544\uc740 \ube44\uacf5\uac1c\uc785\ub2c8\ub2e4. \uc608\uce21\uc774 \uacf5\uac1c\ub418\ub294 \uac83\uc744 \uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\",XQ=\"\uc774 \ud398\uc774\uc9c0\ub97c \ubcf4\uc2dc\ub824\uba74 \ub85c\uadf8\uc778\ud558\uc138\uc694.\",eG=\"\ucd5c\uc2e0 \ub274\uc2a4\",tG=\"\ubaa8\ub4e0 \uc778\uae30\uc608\uce21 \ubcf4\uae30\",oG=\"\uc81c\uc7ac\ubc1b\uc740 \uc0ac\uc6a9\uc790\",nG=\"\uc124\uc815\",sG=\"\uc124\uc815\",aG=\"ROI\",rG=\"\ud68c\uc6d0\uac00\uc785\uc77c\",iG=\"\ud504\ub85c\ud544 \uac1c\uc778\uc815\ubcf4 \ubcf4\ud638\",cG=\"\ub0b4 \ud314\ub85c\uc6cc\ub4e4\",lG=\"\ub0b4\uac00 \ud314\ub85c\uc6b0 \uc911\",_G=\"\ud314\ub85c\uc789\",dG=\"\uc5c5\ub85c\ub4dc\",uG=\"\uc2e0\uaddc \uacc4\uc815\ub4f1\ub85d\",pG=\"\uc77c\ubc18 \uc124\uc815\",mG=\"\ub9c8\uc774 \ub9ac\uadf8\",fG=\"\uc0c1\uc704 \uad6d\uac00\ub85c \ub3cc\uc544\uac00\uae30\",gG=\"\uc608\uce21\uc774 1,000\uac1c \uc774\uc0c1\uc774\uba74\uc11c, \ucd5c\uadfc 30\uc77c\uac04 \uc608\uce21\uc774 100\uac1c \uc774\uc0c1\uc778 \ubaa8\ub4e0 \uad6d\uac00\uac00 \uc5ec\uae30 \ud45c\uc2dc\ub418\uba70, ROI\ub97c \uae30\uc900\uc73c\ub85c \uc815\ub82c\ub429\ub2c8\ub2e4.\",hG=\"\uc9c0\uae08 \ud65c\uc131\ud654\",yG=\"\uc778\uae30 \uc0ac\uc6a9\uc790\",bG=\"\uc0c1\uc704 \uad6d\uac00\",vG=\"\ub808\ubca8\ubca0\ud305 \ub3c4\uc804!\",wG=\"\ubc38\ub958\ubca0\ud305 \ub3c4\uc804!\",CG=\"\uc720\uc758\uc0ac\ud56d \",AG=\"\uc624\uc988\ud3ec\ud0c8\uc740 \ubc38\ub958\ubca0\ud305 \uc18c\ud504\ud2b8\uc6e8\uc5b4\ub97c \uc6b4\uc601\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\",kG=\". \uc9c8\ubb38\uc774\ub098 \uc81c\uc548\uc0ac\ud56d\uc774 \uc788\uc73c\uc2dc\uba74 \ubc38\ub958\ubca0\ud305 \uc9c0\uc6d0\ud300\uc5d0 \ubb38\uc758\ud558\uc138\uc694 \",IG=\"\uc9c0\uc6d0\ud300\",TG=\". \uc624\uc988\ud3ec\ud0c8\uc758 \uc774\uc6a9\uc57d\uad00\uc740 \uc774 \uc11c\ube44\uc2a4\uc5d0 \uc801\uc6a9\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\",xG=\"\uc774 \ub9ac\uadf8\ub97c \ub9c8\uc774\ub9ac\uadf8\uc5d0\uc11c \uc81c\uac70\",EG=\"\uae00\ub85c\ubc8c \ubd81\uba54\uc774\ucee4\",SG=\"\ubc95\uc801\uc73c\ub85c \ubd81\uba54\uc774\ucee4 \uc804\uccb4\ub97c \uc120\ud0dd\ud560 \uc218 \uc5c6\ub294 \uc9c0\uc5ed\uc5d0\uc11c \uc811\uadfc \uc911\uc785\ub2c8\ub2e4.\",PG=\"\ud604\uc9c0 \ubd81\uba54\uc774\ucee4\",OG=\"URL\",$G=\"\uc2e4\uc2dc\uac04 \ubca0\ud305\",NG=\"\uc2e4\uc2dc\uac04 \uc2a4\ud2b8\ub9ac\ubc0d\",zG=\"\uc2e4\uc2dc\uac04 \uc2a4\ud2b8\ub9ac\ubc0d\",jG=\"\uace0\uac1d\uc9c0\uc6d0\",MG=\"\uc9c0\uc6d0 \uc774\uba54\uc77c\",LG=\"\uc9c0\uc6d0 \uc804\ud654\",BG=\"\ub77c\uc774\ube0c \ucc57\",RG=\"\ubca0\ud305 \uaddc\uce59\",DG=\"\uc774\uc6a9\uc57d\uad00\",HG=\"\uc6f9\uc0ac\uc774\ud2b8\",UG=\"\ub0b4 \ud3c9\uac00\",FG=\"\ubc30\ub2f9\ub960 \ud488\uc9c8\",QG=\"BMR \ud3c9\uac00\",GG=\"\uc0ac\uc6a9\uc790 \ud3c9\uac00\",WG=\"\ud3c9\uac00 \ucde8\uc18c\",VG=\"\uc804\uccb4 \ud3c9\uac00\",qG=\"\ud604\uc9c0 \ubd81\uba54\uc774\ucee4\",YG=\"\uc8fc\uc18c\",JG=\"\uc9c0\uae08 \ubcf4\ub108\uc2a4\ub97c \uc2e0\uccad\ud558\uc138\uc694\",ZG=\"\uc5b8\uc5b4 \ubc84\uc804\",KG=\"\ubc30\ub2f9\ub960 \ud615\uc2dd\",XG=\"\uc785\uae08\ubc29\ubc95\",eW=\"\ucd9c\uadfc\ubc29\ubc95\",tW=\"\uc2e0\uc6a9\uce74\ub4dc\",oW=\"\uc9c1\ubd88\uce74\ub4dc\",nW=\"\ud604\uae08\",sW=\"\ucd5c\uc18c \uc785\uae08\uc561\",aW=\"\ucd5c\uc18c \ubca0\ud305\uc561\",rW=\"\ucd5c\ub300 \ubca0\ud305\uc561\",iW=\"\ucd5c\ub300 \uc2b9\ub960\",cW=\"\ub9c8\uc774 \ub9e4\uce58\",lW=\"\ub9c8\uc774\",_W=\"\ucd94\uac00\",dW=\"\uc0ad\uc81c\",uW=\"\uae4c\uc9c0\",pW=\"\ubd80\ud130\",mW=\"\uc624\ub298\",fW=\"\ub0b4\uc77c\",gW=\"\uc5b4\uc81c\",hW=\"\ub0b4\uc77c\",yW=\"\uc5b4\uc81c\",bW=\"\ubaa8\ub4e0\",vW=\"\uc77c\uc694\uc77c\",wW=\"\uc6d4\uc694\uc77c\",CW=\"\ud654\uc694\uc77c\",AW=\"\uc218\uc694\uc77c\",kW=\"\ubaa9\uc694\uc77c\",IW=\"\uae08\uc694\uc77c\",TW=\"\ud1a0\uc694\uc77c\",xW=\"Show less\",EW=\"\uc624\ubc84\",SW=\"\uc5b8\ub354\",PW=\"\ud640\",OW=\"\uc9dd\",$W=\"Winner\",NW=\"\ubca0\ud305\",zW=\"\uc88b\uc544\uc694\",jW=\"\uc88b\uc544\uc694\ub97c \ub204\ub978\",MW=\"\uacc4\uc815 \uc2e0\uace0\",LW=\"\ubcf4\ub0b4\uae30\",BW=\"\ucde8\uc18c\",RW=\"\ucd08\uae30 \ubc30\ub2f9\ub960\",DW=\"\uc870\ud569\uc740 \ud5c8\uc6a9\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4\",HW=\"\uc774 \ubca0\ud305\uc740 \ub354 \uc774\uc0c1 \ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4\",UW=\"\ub0b4 \ucfe0\ud3f0\uc5d0 \ucd94\uac00\",FW=\"\ub0b4 \ucfe0\ud3f0\uc5d0\uc11c \uc81c\uac70\",QW=\"\uc774 \uacb0\uacfc\ub97c \uc608\uce21\",GW=\"\ub0b4 \uc608\uce21\",WW=\"\ub0b4 \ub9ac\uadf8 \uad00\ub9ac\",VW=\"\uc774 \uba54\uc2dc\uc9c0\ub97c \uc228\uae30\ub824\uba74, \ubd81\uba54\uc774\ucee4 \ub4f1\uc744 \ub9de\ucda4\uc124\uc815 \ud558\uc138\uc694.\",qW=\"\uc6d0\uaca9 \ubca0\ud305\uc804\ud45c\ub97c \uc774\uc6a9\ud558\uc5ec\",YW=\"\ucfe0\ud3f0\uc5d0 \uac00\uc7a5 \uc801\ud569\ud55c\",JW=\"\ubd81\uba54\uc774\ucee4\ub97c \ucc3e\uc73c\uc138\uc694\",ZW=\"\ud56b\ub9e4\uce58\",KW=\"\ud0d1\uc720\uc800 \uc608\uce21\",XW=\"\uc21c\uc704\",eV=\"\uce74\ud14c\uace0\ub9ac\",tV=\"\ucc3d \ub2eb\uae30\",oV=\"\ud53d\",nV=\"\uc608\uce21\uc744 \uc81c\ucd9c\ud558\uae30 \uc704\ud574 \ub85c\uadf8\uc778\ud558\uc138\uc694\",sV=\"\ub0b4 \uc608\uce21\uc5d0 \ucd94\uac00\",aV=\"\ub0b4 \uc608\uce21 \ubcc0\uacbd\",rV=\"\ub0b4 \uc608\uce21\uc5d0\uc11c \uc81c\uc678\",iV=\"\ub354 \uc774\uc0c1 \uc218\uc815 \ubd88\uac00\",cV=\"\uc774 \uacbd\uae30\ub294 \uc5f0\uae30\ub418\uc5c8\uc2b5\ub2c8\ub2e4\",lV=\"\uc774 \uacbd\uae30\ub294 \uc885\ub8cc\ub418\uc5c8\uc2b5\ub2c8\ub2e4\",_V=\"\uc774 \uacbd\uae30\ub294 \uc774\ubbf8 \uc2dc\uc791\ub418\uc5c8\uc2b5\ub2c8\ub2e4\",dV=\"\uc8c4\uc1a1\ud569\ub2c8\ub2e4!\",uV=\"\uc608\uce21\uc774 \ubd88\uac00\ud569\ub2c8\ub2e4.\",pV=\"\uc608\uce21 \uc0ad\uc81c\uac00 \uc9c4\ud589 \uc911\uc785\ub2c8\ub2e4.\",mV=\"\uc544\uc9c1 \uc608\uce21\uc744 \ud558\uc9c0 \uc54a\uc73c\uc168\uc2b5\ub2c8\ub2e4. \uccab \ubc88\uc9f8 \uc608\uce21\uc774 \ud655\uc815\ub418\uc790\ub9c8\uc790 \uc694\uc57d\uc774 \ud45c\uc2dc\ub429\ub2c8\ub2e4.\",fV=\"\uc608\uce21 \uc0ad\uc81c\",gV=\"\uacc4\uc815 \uc0ad\uc81c\",hV=\"\ubaa8\ub4e0 \uc608\uce21 \uc0ad\uc81c\",yV=\"\ubaa8\ub4e0 \uc608\uce21\uc744 \uc0ad\uc81c\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?\",bV=\"\ubaa8\ub4e0 \uc608\uce21 \uc0ad\uc81c\ub97c \ucde8\uc18c\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?\",vV=\"\uadc0\ud558\uc758 \ucd5c\uadfc \ubaa8\ub4e0 \uc608\uce21\uc744 \uc0ad\uc81c\ud588\uc2b5\ub2c8\ub2e4. 30\uc77c \ud6c4\uc5d0 \uc608\uce21\uc744 \uc0ad\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\",wV=\"\uacc4\uc815\uc744 \uc0ad\uc81c\ud558\ub824\uba74 \uc544\ub798 \ubc84\ud2bc\uc744 \ud074\ub9ad\ud558\uc138\uc694. \uadc0\ud558\uc758 \uacc4\uc815\uacfc \ubaa8\ub4e0 \uc124\uc815\uc774 \uc601\uad6c\uc801\uc73c\ub85c \uc0ad\uc81c\ub429\ub2c8\ub2e4.\",CV=\"\ubaa8\ub4e0 \uc608\uce21\uc774 10\ubd84 \ub0b4\uc5d0 \uc0ad\uc81c\ub429\ub2c8\ub2e4\",AV=\"\uae30\uc874 \ube44\ubc00\ubc88\ud638\uac00 \uc77c\uce58\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\",kV=\"\uc0ac\uc6a9\uc790\uc774\ub984\uc5d0 \ub9de\ub294 \ube44\ubc00\ubc88\ud638\uac00 \uc544\ub2d9\ub2c8\ub2e4\",IV=\"\uc124\uc815\uc774 \uc800\uc7a5\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\",TV=\"\uacf5\uac1c \ud504\ub85c\ud544\",xV=\"\ubaa8\ub4e0 \uc0ac\uc6a9\uc790\uac00 \uadc0\ud558\uc758 \ud504\ub85c\ud544\uacfc \uc608\uce21\uc744 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4.\",EV=\"\ube44\uacf5\uac1c \ud504\ub85c\ud544\",SV=\"\ubaa8\ub4e0 \uc0ac\uc6a9\uc790\uac00 \uadc0\ud558\uc758 \uc608\uce21\uc744 \ubcfc \uc218 \uc5c6\uc73c\uba70, \ud314\ub85c\uc6b0\ub3c4 \ubd88\uac00\ud569\ub2c8\ub2e4.\",PV=\"\uadc0\ud558\uc758 \uacc4\uc815\uc774 10\ubd84 \ub0b4\uc5d0 \uc0ad\uc81c\ub429\ub2c8\ub2e4.\",OV=\"\ub354 \uc790\uc138\ud788 \ubcf4\uae30\",$V=\"\uc5f0\ub77d\",NV=\"\uc608\uce21 \uc0ad\uc81c: \uadc0\ud558\uc758 \ubaa8\ub4e0 \uc608\uce21\uc744 \uc0ad\uc81c\ud558\ub824\uba74 \uc544\ub798 \ubc84\ud2bc\uc744 \ud074\ub9ad\ud558\uc138\uc694. \uadc0\ud558\uac00 \uacfc\uac70\uc5d0 \uc0dd\uc131\ud55c \ubaa8\ub4e0 \uc608\uce21\uacfc \ud1b5\uacc4\uac00 \uc601\uad6c\uc801\uc73c\ub85c \uc0ad\uc81c\ub418\uba70, \uadc0\ud558\uc758 ROI\ub294 0%\uac00 \ub429\ub2c8\ub2e4. \uc608\uce21\uc740 30\uc77c\uc5d0 \ud55c\ubc88\uc529 \uc0ad\uc81c \uac00\ub2a5\ud569\ub2c8\ub2e4.\",zV=\"\uc77c.\",jV=\"\ubaa8\ub4e0 \uc608\uce21\uc774 \uc131\uacf5\uc801\uc73c\ub85c \uc81c\uac70\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\",MV=\"\ubcf4\ub958\",LV=\"\uc2b9\",BV=\"\ubbf8\uc801\uc911\",RV=\"\ubb34\ud6a8\",DV=\"\uc544\uc9c1 \uacb0\uacfc\uac00 \ub098\uc624\uc9c0 \uc54a\uc74c\",HV=\"\ubb34\",UV=\"\ud604\uc7ac \ubd81\uba54\uc774\ucee4\uac00 \uc81c\uacf5\ud558\ub294 LIVE \uacbd\uae30\ubc30\ub2f9\ub960\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.\",FV=\"\uc608\uc815\ub41c \ub77c\uc774\ube0c \ubc30\ub2f9\ub960 \ud504\ud3ec\uadf8\ub7a8\uc744 \uccb4\ud06c\ud558\uc138\uc694.\",QV=\"\uc608\uc815 \uacbd\uae30\",GV=\"\uae30\ud0c0 \uc2e4\uc2dc\uac04 \uacbd\uae30\",WV=\"\uc774\uc6a9\uac00\ub2a5\ud55c \ubd81\uba54\uc774\ucee4 \ubc30\ub2f9\ub960 \uc218\",VV=\"\ub2e4\uc74c\",qV=\"\ubaa8\ub450 \uc228\uae30\uae30\",YV=\"\uc228\uaca8\uc9c4\",JV=\"\uadc0\ud558\uc758 \uac1c\uc778\uc5d0 \ub9de\ub294 \ubc30\ub2f9\ub960\",ZV=\"\ub2eb\ud78c \ubc30\ub2f9\",KV=\"\ucd08\uae30 \ubc30\ub2f9\ub960:\",XV=\"\uc9c0\uae08 \ubca0\ud305\ud558\ub824\uba74 \ud074\ub9ad\ud558\uc138\uc694\",eq=\"\ud310\ub3c8\uc744 \uacc4\uc0b0\ud558\ub824\uba74 \uc5ec\uae30\ub97c \ud074\ub9ad\ud558\uc138\uc694\",tq=\"\uc6d0\uaca9 \ud22c\ud45c\uc9c0\",oq=\"\ubca0\ud305 \uc218\uc218\ub8cc\",nq=\"\ube44\ud65c\uc131 \ubc30\ub2f9\ub960 \uc228\uae30\uae30\",sq=\"\uc804\uccb4 \ubcf4\uae30\",aq=\"\uc228\uaca8\uc9c4 \ubd81\uba54\uc774\ucee4\",rq=\"\uadf8\ub4e4 \uc911 \ud558\ub098\ub97c \ube44\uad50\uc5d0 \ucd94\uac00\ud558\ub824\uba74\",iq=\"\uacbd\uae30\",cq=\"\ub85c\uadf8\uc778 \ud6c4 \uc624\uc988\uc54c\ub7ff\uc744 \ud655\uc778\ud558\uc138\uc694!\",lq=\"\ubc30\ub2f9\ub960 \uc54c\ub9bc \uc124\uc815\",_q=\"\uc624\uc988\uc54c\ub7ff\",dq=\"\ubc30\ub2f9\ub960\uc774 \ud2b9\uc815\uac12 \uc774\uc0c1\uc774 \ub418\uba74 \uc54c\ub9bc\",uq=\"\uc774 \uacbd\uae30\ub294 \uc885\ub8cc\ub418\uc5c8\uc2b5\ub2c8\ub2e4\",pq=\"\ud574\ub2f9 \uad6d\uac00\uc5d0\uc11c\ub294 \uc9c0\uc6d0\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4\",mq=\"\uc54c\ub9bc \ub044\uae30\",fq=\"\uc54c\ub9bc \ub044\uae30\",gq=\"\uc635\uc158\",hq=\"\uc218\uc815\ud558\uc2dc\ub824\uba74 \uc5ec\uae30\ub97c \ud074\ub9ad\ud558\uc138\uc694!\",yq=\"\uc54c\ub9bc \ucde8\uc18c\",bq=\"\uc54c\ub9bc \uc218\uc815\",vq=\"\ud074\ub9ad \ud6c4 \ud655\uc778\",wq=\"\ubd81\uba54\uc774\ucee4\uac00 \ub354 \uc788\uc2b5\ub2c8\ub2e4\",Cq=\"\ubc30\ub2f9\ub960\uc774 \uc774 \uac12 \uc774\uc0c1\uc774\uba74 \uc54c\ub9bc:\",Aq=\"\uc544\uc9c1 \uc608\uce21\uc744 \ud558\uc9c0 \uc54a\uc73c\uc168\uc2b5\ub2c8\ub2e4.\",kq=\"\uc0ac\uc6a9\uc790 \uc608\uce21\",Iq=\"\uc0ac\uc6a9\uc790 \uc608\uce21\uc740 \uc624\uc988\ud3ec\ud0c8 \uc0ac\uc6a9\uc790\ub4e4\ub85c\ubd80\ud130 \uc218\uc9d1\ub41c \uac83\uc785\ub2c8\ub2e4.\",Tq='\uc608\uce21\uc744 \ucd94\uac00\ud558\uc2dc\ub824\uba74 \uacbd\uae30\uc0c1\uc138\uc758 \"\uc608\uce21\" \ubc84\ud2bc \ub610\ub294 \ud37c\uc13c\ud2b8 \ubc14\ub97c \ud074\ub9ad\ud558\uc138\uc694.',xq=\"\uc774\uc6a9\uac00\ub2a5\ud55c \ubc30\ub2f9\uc774 \uc5c6\uc2b5\ub2c8\ub2e4. \\\\'\ube44\ud65c\uc6a9 \ubc30\ub2f9 \uc228\uae30\uae30\\\\' \uc124\uc815\uc744 \uc774\uc6a9 \uc911\uc785\ub2c8\ub2e4.\",Eq=\"\ub0b4 \ucfe0\ud3f0\",Sq=\"\ucd5c\uace0\",Pq=\"\uc9c0\ubd88\",Oq=\"\ubc30\ub2f9\ub960\uc774 \uc77c\uc2dc\uc801\uc73c\ub85c \uc5c5\ub370\uc774\ud2b8\ub418\uc9c0 \uc54a\uace0 \uc788\uc2b5\ub2c8\ub2e4.\",$q=\"\uc2e4\uc2dc\uac04 \uc2a4\ud2b8\ub9ac\ubc0d\uc744 \uc2dc\uccad\ud558\uc138\uc694\",Nq=\"\uc774\ub3d9\",zq=\"\ub4a4\ub85c\",jq=\"\ubc30\uce58\",Mq=\"\ubd84\",Lq=\"\ucd08\uae30 \ubc30\ub2f9\ub960\",Bq=\"\uc0c1\uc138\",Rq=\"\ud301\",Dq=\"\ub9ce\uc740\",Hq=\"\uc0ac\uc6a9\uc790\ub4e4\uc774 \uc774\uac83\uc744 \uc608\uce21\",Uq=\"\uc774\ub97c \uc608\uce21\ud55c \uc0ac\uc6a9\uc790\ub4e4\uc758 \ud3c9\uade0 ROI\",Fq=\"\ubcf4\ub108\uc2a4\",Qq=\"\uc774 \uacbd\uae30\uc5d0 \uc774\uc6a9\uac00\ub2a5\ud55c \ubc30\ub2f9\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.\",Gq=\"\ubc30\ub2f9\ub960\uc744 \ubcf4\uc2dc\ub824\uba74 \ub85c\uadf8\uc778 \ub610\ub294 \ubb34\ub8cc\uac00\uc785 \ud558\uc138\uc694!\",Wq=\"\ubc30\ub2f9\ub960\uc744 \ubcf4\uc2dc\ub824\uba74\",Vq=\"\ubc30\ub2f9\ub960\uc744 \ubcf4\uc2dc\ub824\uba74 \ub85c\uadf8\uc778 \ub610\ub294 \uac00\uc785 \ud558\uc138\uc694!\",qq=\"\ub354 \ub9ce\uc740 \ubd81\uba54\uc774\ucee4\ub97c \ubcf4\uc2dc\ub824\uba74 \ud074\ub9ad\ud558\uc138\uc694\",Yq=\"\ubc30\ub2f9\ub960\uc744 \ubcf4\uc2dc\ub824\uba74 \ub85c\uadf8\uc778 \ud558\uc138\uc694!\",Jq=\"\ubaa8\ub4e0 \uacbd\uae30\",Zq=\"\ud558\uc640\uc774\",Kq=\"\uc54c\ub798\uc2a4\uce74\",Xq=\"\ubc14\ud558 \uce98\ub9ac\ud3ec\ub2c8\uc544\",eY=\"\ud0dc\ud3c9\uc591\ud45c\uc900\uc2dc (\ubbf8\uad6d & \uce90\ub098\ub2e4)\",tY=\"\uc560\ub9ac\uc870\ub098\",oY=\"\uce58\uc640\uc640, \ub77c\ud30c\uc2a4, \ub9c8\uc0ac\ud2c0\ub780\",nY=\"\uc0b0\uc9c0\ud45c\uc900\uc2dc (\ubbf8\uad6d & \uce90\ub098\ub2e4)\",sY=\"\uc911\uc559\uc544\uba54\ub9ac\uce74\",aY=\"\uc911\ubd80\ud45c\uc900\uc2dc (\ubbf8\uad6d & \uce90\ub098\ub2e4)\",rY=\"\uacfc\ub2ec\ub77c\ud558\ub77c, \uba55\uc2dc\ucf54\uc2dc\ud2f0, \ubaac\ud14c\ub808\uc774\",iY=\"\ubcf4\uace0\ud0c0, \ub9ac\ub9c8, \ud0a4\ud1a0\",cY=\"\ub3d9\ubd80\ud45c\uc900\uc2dc (\ubbf8\uad6d & \uce90\ub098\ub2e4)\",lY=\"\uc778\ub514\uc560\ub098 (\ub3d9\ubd80)\",_Y=\"\uce74\ub77c\uce74\uc2a4\",dY=\"\uc544\uc21c\uc2dc\uc628\",uY=\"\ub300\uc11c\uc591\ud45c\uc900\uc2dc (\uce90\ub098\ub2e4)\",pY=\"\ucfe0\uc774\uc544\ubc14\",mY=\"\uc870\uc9c0\ud0c0\uc6b4, \ub77c\ud30c\uc2a4, \ub9c8\ub098\uc6b0\uc2a4, \uc0b0\ud6c4\uc548\",fY=\"\uc0b0\ud2f0\uc544\uace0\",gY=\"\ub274\ud380\ub4e4\ub79c\ub4dc\",hY=\"\ube0c\ub77c\uc9c8\ub9ac\uc544\",yY=\"\ubd80\uc5d0\ub178\uc2a4\uc544\uc774\ub808\uc2a4\",bY=\"\uce74\uc774\uc5d4, \ud3ec\ub974\ud0c8\ub808\uc790\",vY=\"\uadf8\ub9b0\ub780\ub4dc\",wY=\"\ubaac\ud14c\ube44\ub370\uc624\",CY=\"\uc544\uc18c\ub974\uc2a4\uc81c\ub3c4\",AY=\"\uce74\ubcf4\ubca0\ub974\ub370\",kY=\"\uce74\uc0ac\ube14\ub791\uce74\",IY=\"\ub354\ube14\ub9b0, \uc5d0\ub4e0\ubc84\ub7ec, \ub9ac\uc2a4\ubcf8, \ub7f0\ub358\",TY=\"\ubaac\ub85c\ube44\uc544, \ub808\uc774\uceac\ube44\ud06c\",xY=\"\uc554\uc2a4\ud14c\ub974\ub2f4, \ubca0\ub97c\ub9b0, \ubca0\ub978, \ub85c\ub9c8, \uc2a4\ud1a1\ud640\ub984\",EY=\"\ud504\ub77c\ud558, \ubca0\uc624\uadf8\ub77c\ub4dc, \ube0c\ub77c\ud2f0\uc2ac\ub77c\ubc14, \ubd80\ub2e4\ud398\uc2a4\ud2b8, \ube48\",SY=\"\ube0c\ub93c\uc140, \ucf54\ud39c\ud558\uac90, \ub9c8\ub4dc\ub9ac\ub4dc, \ud30c\ub9ac\",PY=\"\uc0ac\ub77c\uc608\ubcf4, \uc2a4\ucf54\ud398, \ubc14\ub974\uc0e4\ubc14, \uc790\uadf8\ub808\ube0c, \ub958\ube14\ub7b4\ub098\",OY=\"\uc774\uc2a4\ud0c4\ubd88\",$Y=\"\uc554\ub9cc\",NY=\"\uc544\ud14c\ub124, \ubd80\ucfe0\ub808\uc288\ud2f0\",zY=\"\ubca0\uc774\ub8e8\ud2b8\",jY=\"\uce74\uc774\ub85c\",MY=\"\ub2e4\ub9c8\uc2a4\ucee4\uc2a4\",LY=\"\ud558\ub77c\ub808, \ud504\ub808\ud1a0\ub9ac\uc544\",BY=\"\ud5ec\uc2f1\ud0a4, \ud0a4\uc774\uc6b0, \ub9ac\uac00, \uc18c\ud53c\uc544, \ud0c8\ub9b0, \ube4c\ub274\uc2a4\",RY=\"\uc608\ub8e8\uc0b4\ub818\",DY=\"\ubbfc\uc2a4\ud06c\",HY=\"\ube48\ud2b8\ud6c4\ud06c\",UY=\"\ubc14\uadf8\ub2e4\ub4dc\",FY=\"\ucfe0\uc6e8\uc774\ud2b8, \ub9ac\uc57c\ub4dc\",QY=\"\ubaa8\uc2a4\ud06c\ubc14, \uc0c1\ud2b8\ud398\ud14c\ub974\ubd80\ub974\ud06c, \ubcfc\uace0\uadf8\ub77c\ub4dc\",GY=\"\ub098\uc774\ub85c\ube44\",WY=\"\ud14c\ud5e4\ub780\",VY=\"\uc544\ubd80\ub2e4\ube44, \ubb34\uc2a4\uce74\ud2b8\",qY=\"\ubc14\ucfe0\",YY=\"\ud3ec\ud2b8\ub8e8\uc774\uc2a4\",JY=\"\ud2b8\ube4c\ub9ac\uc2dc\",ZY=\"\uc608\ub808\ubc18\",KY=\"\uce74\ubd88\",XY=\"\uc608\uce74\ud14c\ub9b0\ubd80\ub974\ud06c\",eJ=\"\uc774\uc2ac\ub77c\ub9c8\ubc14\ub4dc, \uce74\ub77c\uce58\",tJ=\"\ud0c0\uc288\ucf04\ud2b8\",oJ=\"\uccb8\ub098\uc774, \uce98\ucee4\ud0c0, \ubb44\ubc14\uc774, \ub274\ub378\ub9ac\",nJ=\"\uc2a4\ub9ac\uc790\uc57c\uc640\ub974\ub370\ub124\ud478\ub77c\ucf54\ud14c\",sJ=\"\uce74\ud2b8\ub9cc\ub450\",aJ=\"\uc544\uc2a4\ud0c0\ub098\",rJ=\"\ub2e4\uce74\",iJ=\"\ub178\ubcf4\uc2dc\ube44\ub974\uc2a4\ud06c\",cJ=\"\uc591\uace4\",lJ=\"\ubc29\ucf55, \ud558\ub178\uc774, \uc790\uce74\ub974\ud0c0\",_J=\"\ud06c\ub77c\uc2a4\ub178\uc57c\ub974\uc2a4\ud06c\",dJ=\"\ubca0\uc774\uc9d5, \ucda9\uce6d, \ud64d\ucf69, \uc6b0\ub8e8\ubb34\uce58\",uJ=\"\uc774\ub974\ucfe0\uce20\ud06c\",pJ=\"\ucf78\ub77c\ub8f8\ud478\ub974, \uc2f1\uac00\ud3ec\ub974\",mJ=\"\ud37c\uc2a4\",fJ=\"\ud0c0\uc774\ubca0\uc774\",gJ=\"\uc6b8\ub780\ubc14\ud1a0\ub974\",hJ=\"\uc624\uc0ac\uce74, \uc0bf\ud3ec\ub85c, \ub3c4\ucfc4\",yJ=\"\uc11c\uc6b8\",bJ=\"\uc57c\ucfe0\uce20\ud06c\",vJ=\"\uc560\ub4e4\ub808\uc774\ub4dc\",wJ=\"\ub2e4\uc708\",CJ=\"\ube0c\ub9ac\uc988\ubc88\",AJ=\"\uce94\ubc84\ub77c, \uba5c\ubc84\ub978, \uc2dc\ub4dc\ub2c8\",kJ=\"\uad0c, \ud3ec\ud2b8\ubaa8\ub974\uc988\ube44\",IJ=\"\ud638\ubc14\ud2b8\",TJ=\"\ube14\ub77c\ub514\ubcf4\uc2a4\ud1a0\ud06c\",xJ=\"\ub9c8\uac00\ub2e8, \uc194\ub85c\ubaac\uc81c\ub3c4, \ub274\uce7c\ub808\ub3c4\ub2c8\uc544\",EJ=\"\uc624\ud074\ub79c\ub4dc, \uc6f0\ub9c1\ud134\",SJ=\"\ud53c\uc9c0\",PJ=\"\ub204\ucfe0\uc54c\ub85c\ud30c\",OJ=\"\ud68c\uc6d0\uac00\uc785 \ucde8\uc18c\",$J=\"\uc0ac\uc6a9\uc790\uc774\ub984 \ub610\ub294 \ucf54\ub4dc \uc624\ub958\",NJ=\"\ud398\uc774\uc9c0\uc5d0 \uc624\ub958\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4. \ub098\uc911\uc5d0 \ub2e4\uc2dc \uc2dc\ub3c4\ud574\uc8fc\uc138\uc694.\",zJ=\"\uadc0\ud558\uac00 \ud314\ub85c\uc6b0\ud558\ub294 \uc0ac\uc6a9\uc790\",jJ=\"\ubaa8\ub4e0 \uc0ac\uc6a9\uc790\",MJ=\"SubjectUID\uac00 \uc720\ud6a8\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4!\",LJ=\"\ub2e4\ub978\",BJ=\"\uc758\ubb34\uc0ac\ud56d\",RJ=\"\uc544\uc9c1 \uacc4\uc815\uc774 \uc5c6\ub2e4\uba74\",DJ=\"\ubb34\ub8cc\ub85c \uc774\uc6a9 \uac00\ub2a5\ud569\ub2c8\ub2e4.\",HJ=\"\ubcc0\uc218 objectUID\uac00 \uc798\ubabb\ub418\uc5c8\uc2b5\ub2c8\ub2e4!\",UJ=\"\uc8c4\uc1a1\ud569\ub2c8\ub2e4! \ud574\ub2f9 \uc0ac\uc6a9\uc790 \ud504\ub85c\ud544\uc774 \ube44\uacf5\uac1c\uc774\ubbc0\ub85c \ud56d\ubaa9\uc744 \ud45c\uc2dc\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.\",FJ=\"\uc548\ud0c0\uae5d\uac8c\ub3c4 \ud574\ub2f9 \ud56d\ubaa9\uc774 \uc5c6\uc2b5\ub2c8\ub2e4. \uc18c\uc720\uc790\uac00 \uc0ad\uc81c\ud55c \uac83 \uac19\uc2b5\ub2c8\ub2e4.\",QJ=\"\uc544\uc9c1 \uc5b4\ub5a4 \uc608\uce21\ub3c4 \uc5c6\uc2b5\ub2c8\ub2e4. \uc608\uce21\ud1b5\uacc4\ub294 \uccab \ubc88\uc9f8 \uc608\uce21\uc774 \ud655\uc815\ub418\ub294 \uc989\uc2dc \ud45c\uc2dc\ub429\ub2c8\ub2e4.\",GJ=\"\ucee4\ubba4\ub2c8\ud2f0\uac00 \uc0dd\uc131\ub41c \uc774\ud6c4 \uc5b4\ub5a4 \uc608\uce21\ub3c4 \uc0dd\uc131\ub418\uc9c0 \uc54a\uc558\uae30 \ub54c\ubb38\uc785\ub2c8\ub2e4.\",WJ=\"\ud30c\ub77c\ubbf8\ud130 \uc624\ub958!\",VJ=\"\uc774\uac83\uc744 \uc88b\uc544\ud558\ub294 \uc0ac\ub78c\",qJ=\"\uc774\uac83\uc744 \uc88b\uc544\ud558\ub294 \uc0ac\ub78c\ub4e4\",YJ=\"\ub313\uae00 \ud45c\uc2dc/\ucd94\uac00\",JJ=\"\ub4f1\ub85d\",ZJ=\"\ub313\uae00 \ub2ec\uae30 \u2026\",KJ=\"\uc774 \ub313\uae00\uc744 \uc815\ub9d0 \uc0ad\uc81c\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?\",XJ=\"\uc544\uc9c1 \ud314\ub85c\uc6b0\ud55c \uc0ac\uc6a9\uc790\uac00 \uc5c6\uac70\ub098 \ube44\uacf5\uac1c \uc0ac\uc6a9\uc790\uc774\uae30 \ub54c\ubb38\uc5d0 \ud53c\ub4dc\uac00 \uc5c6\uc2b5\ub2c8\ub2e4.\",eZ=\"\ub313\uae00\",tZ=\"\uacf5\uc720\",oZ=\"\ub354 \ubcf4\uc2dc\ub824\uba74 \ud074\ub9ad\ud558\uc138\uc694\",nZ=\"\ub85c\ub529 \uc911\",sZ=\"\ub313\uae00\",aZ=\"\uc2e0\uace0\",rZ=\"\ub313\uae00 \uc0ad\uc81c\",iZ=\"\uc0ac\uc6a9\uc790\uac00 \uc88b\uc544\ud569\ub2c8\ub2e4\",cZ=\"\uc608\uce21\uc774 \uc0ad\uc81c\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\",lZ=\"\uc544\uc9c1\",_Z=\"\uacc4\uc815\uc774 \uc5c6\uc73c\uc2dc\uba74\",dZ=\"\ub85c\uadf8\uc778\uc774 \ud544\uc694\ud569\ub2c8\ub2e4\",uZ=\"\uc624\ub978\ucabd-\uba54\uc778_\uacbd\uae30\",pZ=\"\uc544\uc9c1 \uc120\ud0dd\ud558\uc2e0 \ubca0\ud305\uc774 \uc5c6\uc2b5\ub2c8\ub2e4. \ubca0\ud305\uc744 \ucd94\uac00\ud558\uc2dc\ub824\uba74 \uc624\uc988\ud3ec\ud0c8\uc5d0\uc11c \ubc30\ub2f9\ub960\uc744 \ud074\ub9ad\ud558\uc138\uc694!\",mZ=\"\ucfe0\ud3f0 %s\",fZ=\"\ub098\",gZ=\"\uc5d0 \uc758\ud55c \uacf5\uac1c\ucfe0\ud3f0 %s\",hZ=\"\uba54\ubaa8 \ud14d\uc2a4\ud2b8\",yZ=\"\uba54\ubaa8\",bZ=\"\uc774 \uacf5\uac1c\ucfe0\ud3f0\uc744 \uc815\ub9d0\ub85c \uc0ad\uc81c\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?\",vZ=\"\uc774\uba54\uc77c\ub85c \uacb0\uacfc \uc804\ub2ec\",wZ=\"\uc120\ud0dd\ub41c \ubca0\ud305\",CZ=\"\ucd5c\uace0 \ud569\uacc4 \ubc30\ub2f9\ub960\",AZ=\"\ubd81\uba54\uc774\ucee4\",kZ=\"\ud569\uacc4\",IZ=\"\uc778\ub514.\ubc30\ub2f9\ub960\",TZ=\"\ubaa8\ub4e0 \ubd81\uba54\uc774\ucee4 \ubc30\ub2f9\ub960 \ubcf4\uae30\",xZ=\"\ubaa8\ub4e0 \uacbd\uae30\uac00 \uc885\ub8cc\ub418\uace0 \ud310\uc815\uc774 \ub05d\ub098\uba74 \uadc0\ud558\uc758 \ucfe0\ud3f0 \uacb0\uacfc\uac00 \ud3ec\ud568\ub41c \uc774\uba54\uc77c\uc744 \ubc1b\uac8c \ub429\ub2c8\ub2e4. \uc624\ub298 5\uac1c\uc758 \uc774\uba54\uc77c \uc54c\ub9bc\uc774 \ub0a8\uc544\uc788\uc2b5\ub2c8\ub2e4.\",EZ=\"\ub2f9\uc2e0\uc5d0\uac8c\",SZ=\"\ub0a8\uc740 \ubb38\uc790\uac00 \uc788\uc2b5\ub2c8\ub2e4\",PZ=\"\uc800\uc7a5\",OZ=\"\uc800\uc7a5\",$Z=\"\ud3b8\uc9d1\",NZ=\"\uacf5\uac1c\ucfe0\ud3f0 \ub9c1\ud06c\uac00 \ubcf5\uc0ac\ub429\ub2c8\ub2e4\",zZ=\"\uc0bd\uc785\",jZ=\"\uacb0\uacfc\",MZ=\"\ucd94\uc801\ub428\",LZ=\"\ud604\uc7ac\",BZ=\"\ub0b4 \ubaa8\ub4e0 \uacf5\uac1c\ucfe0\ud3f0\",RZ=\"\ub0b4 \uacf5\uac1c\ucfe0\ud3f0\",DZ=\"\uc774 \ucfe0\ud3f0\uc758 \uacb0\uacfc\ub294 <br> \uadc0\ud558\uc758 \uc774\uba54\uc77c\ub85c \uc804\uc1a1\ub429\ub2c8\ub2e4\",HZ=\"\uc774 \ucfe0\ud3f0\uc758 \uacb0\uacfc\ub294 \uadc0\ud558\uc758 \uc774\uba54\uc77c\ub85c \uc804\uc1a1\ub429\ub2c8\ub2e4\",UZ=\"\ucfe0\ud3f0\uc5d0 \ud604\uc7ac \uc815\uc0b0\ub418\uc9c0 \uc54a\uc740 \ubca0\ud305\uc774 \ud3ec\ud568\ub3fc \uc788\uc2b5\ub2c8\ub2e4. \ubd88\ud3b8\uc744 \ub4dc\ub824 \uc8c4\uc1a1\ud569\ub2c8\ub2e4.\",FZ=\"\ub0a0\uc9dc\",QZ=\"\ucfe0\ud3f0\",GZ=\"\ub0b4 \ud504\ub85c\ud544\",WZ=\"\ubaa8\ub4e0 \uacf5\uac1c\ucfe0\ud3f0\",VZ=\"\uacf5\uac1c\ucfe0\ud3f0\",qZ=\"\uc774\uc804\",YZ=\"\ubca0\ud305 \uc801\uc911\",JZ=\"\ubca0\ud305 \ubbf8\uc801\uc911\",ZZ=\"\ubc18\ud658\ub41c \uc9c0\ubd84\",KZ=\"\ud604\uc7ac \uc9c1\uc811\uc801\uc778 \ubca0\ud305\uc744 \uc815\uc0b0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ubd88\ud3b8\uc744 \ub4dc\ub824 \uc8c4\uc1a1\ud569\ub2c8\ub2e4. \",XZ=\"\ucd5c\uc885 \uacb0\uacfc\",eK=\"\uadc0\ud558\uc758 \ud301\uc744 \uc608\uce21\uc73c\ub85c \uc800\uc7a5\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uacbd\uae30\uac00 \uc774\ubbf8 \uc2dc\uc791\ub418\uc5c8\uac70\ub098 \uc774\ubbf8 \uc608\uce21\ud55c \uac83\uc785\ub2c8\ub2e4.\",tK=\"\uc120\ud0dd\ud55c \ubaa8\ub4e0 \ud301\uc774 \uc608\uce21\uc73c\ub85c \uc800\uc7a5\ub429\ub2c8\ub2e4.\",oK=\"\uc774 \uc791\uc5c5\uc744 \uc218\ud589\ud558\ub824\uba74 \ub85c\uadf8\uc778\uc774 \ud544\uc694\ud569\ub2c8\ub2e4\",nK=\"\uacf5\uac1c\ucfe0\ud3f0 \uc18c\uc720\uc790\ub9cc \ucd94\uac00/\ud3b8\uc9d1 \uacf5\uc9c0 \uac00\ub2a5\ud569\ub2c8\ub2e4!\",sK=\"\uacf5\uac1c\ucfe0\ud3f0\uc774 \uc5c6\uc2b5\ub2c8\ub2e4!\",aK=\"\uacf5\uac1c\ucfe0\ud3f0\uc744 \uacf5\uc720\ud560 \uc218 \uc788\uc9c0\ub9cc \ub85c\uadf8\uc778\uc744 \ud574\uc57c \ud569\ub2c8\ub2e4. \uc544\uc9c1 \uacc4\uc815\uc774 \uc5c6\ub2e4\uba74, \uc774\uac83\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4\",rK=\"\ud604\uc7ac \ubc30\ub2f9\ub960\",iK=\"\uc800\uc7a5 & \ubc30\ud3ec\",cK='\ucfe0\ud3f0\uc744 \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uacfc \uacf5\uc720\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4! \"\uc800\uc7a5 & \ubc30\ud3ec\" \ubc84\ud2bc\ub9cc \ud074\ub9ad\ud558\uba74 \uacf5\uc720 \ubc0f \uc54c\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.',lK=\"\uc0ac\uc6a9\uc790\uc774\ub984 \ub610\ub294 \ube44\ubc00\ubc88\ud638\ub97c \uc785\ub825\ud558\uc138\uc694.\",_K=\"\uacc4\uc815\uc744 \ud655\uc778\ud558\uc138\uc694. \ud655\uc778 \uc774\uba54\uc77c\uc774 \uc804\uc1a1\ub418\uc5c8\uc2b5\ub2c8\ub2e4\",dK=\"\uc0ac\uc6a9\uc790\uc774\ub984 \ub610\ub294 \ube44\ubc00\ubc88\ud638 \uc624\ub958.\",uK=\"\uacc4\uc815\uc774 \ucc28\ub2e8\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\",pK=\"\uc800\ud76c\ub97c \uc874\uc911\ud588\ub2e4\uace0 \uc0dd\uac01\ud558\uc2e0\ub2e4\uba74\",mK=\"\ubb38\uc758\ud558\uae30.\",fK=\"\ub85c \ub85c\uadf8\uc778\",gK=\"\ub610\ub294 \uadf8 \uc774\uc0c1\",hK=\"\ub610\ub294 \uadf8 \uc774\uc0c1\",yK=\"\uc544\uc9c1 \uacc4\uc815\uc774 \uc5c6\uc2b5\ub2c8\ub2e4\",bK=\"\ucd5c\uadfc \uc608\uce21\",vK=\"\ucd5c\uadfc 5\uac1c \uc608\uce21\",wK=\"\uc608\uce21 - \uc0ac\uc6a9\uc790\uac00 \uc5c6\uc2b5\ub2c8\ub2e4\",CK=\"%s\uc758 \uc608\uce21\",AK=\"\uc0ac\uc6a9\uc790\uac00 \uc5c6\uc2b5\ub2c8\ub2e4.\",kK=\"\uc694\uc57d\",IK=\"\uacb0\uacfc\",TK=\"\ub2e4\uc74c \uc608\uce21\",xK=\"\ubaa8\ub4e0 \ud1b5\uacc4\",EK=\"\uc774\uc804 \ub2ec\uc744 \ubcf4\uc2dc\ub824\uba74 \ud074\ub9ad\ud558\uc138\uc694\",SK=\"\uc608\uce21 \ub354 \ubcf4\uae30\",PK=\"(\ucd5c\uadfc 30\uc77c \ub3d9\uc548 \ucd5c\uc18c 5\uac1c \uc608\uce21)\",OK=\"\ud574\ub2f9 \ud504\ub85c\ud544\uc740 \uc228\uaca8\uc9c4 \uc0c1\ud0dc\uc785\ub2c8\ub2e4. \uc0ac\uc6a9\uc790 \ud1b5\uacc4\uac00 \ubaa8\ub4e0 \uc0ac\uc6a9\uc790\uc5d0\uac8c \ube44\ub178\ucd9c\ub418\uba70, \uc774 \ud504\ub85c\ud544\uc744 \ud314\ub85c\uc6b0\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \",$K=\"\uc0ac\uc6a9\uc790 \ud1b5\uacc4\uc5d0 \uc811\uadfc\ud558\ub824\uba74 \ub85c\uadf8\uc778\ud558\uc138\uc694.\",NK=\"\uc804\uccb4 \ud1b5\uacc4\",zK=\"\ud3c9\uade0 \ube44\ub331\ub960 / \ucd5c\uace0 \ubc30\ub2f9\ub960\",jK=\"\uc885\ubaa9\ubcc4 ROI\",MK=\"\ubca0\ud305\uc720\ud615\ubcc4 ROI\",LK=\"\ubd81\uba54\uc774\ucee4\ubcc4 ROI\",BK=\"\ub9ac\uadf8\ubcc4 ROI\",RK=\"\ub2ec\",DK=\"\ucd1d \uc608\uce21\",HK=\"\ud3c9\uade0 \ubc30\ub2f9\ub960\",UK=\"\ucd5c\uace0 \ubc30\ub2f9\ub960\",FK=\"\uc885\ubaa9\",QK=\"\ubca0\ud305\uc720\ud615\",GK=\"\ub9ac\uadf8\",WK='\"\ud3c9\uade0 \ubc30\ub2f9\ub960 / \ucd5c\uace0 \ubc30\ub2f9\ub960\"\uc740 \ucd5c\ub300 \ubc0f \ud3c9\uade0 \ub9c8\ucf13 \ubc30\ub2f9\ub960\uc744 \uae30\ubc18\uc73c\ub85c \uc0ac\uc6a9\uc790\uc608\uce21 ROI \ud1b5\uacc4\ub97c \ud45c\uc2dc\ud569\ub2c8\ub2e4.',VK='\"\uc2a4\ud3ec\uce20\ubcc4 ROI\"\ub294 \uc2a4\ud3ec\uce20\ubcc4 \uc0ac\uc6a9\uc790\uc608\uce21 ROI\ud1b5\uacc4\ub97c \ud45c\uc2dc\ud569\ub2c8\ub2e4.',qK='\"\ubca0\ud305\uc720\ud615\ubcc4 ROI\"\ub294 \ud2b9\uc815 \ubca0\ud305\uc720\ud615\ubcc4 \uc0ac\uc6a9\uc790\uc608\uce21 ROI\ud1b5\uacc4\ub97c \ud45c\uc2dc\ud569\ub2c8\ub2e4.',YK='\"\ubd81\uba54\uc774\ucee4\ubcc4 ROI\"\ub294 \ud2b9\uc815 \ubd81\uba54\uc774\ucee4\ubcc4 \uc0ac\uc6a9\uc790\uc608\uce21 ROI\ud1b5\uacc4\ub97c \ud45c\uc2dc\ud569\ub2c8\ub2e4.',JK=\"\uc544\uc9c1 \uc608\uce21\uc744 \ud558\uc9c0 \uc54a\uc73c\uc168\uc2b5\ub2c8\ub2e4. \uc608\uce21 \ud1b5\uacc4\ub294 \uccab \ubc88\uc9f8 \uc608\uce21 \uacb0\uacfc\uac00 \ud655\uc815\ub418\ub294 \uc989\uc2dc \ud45c\uc2dc\ub429\ub2c8\ub2e4.\",ZK=\"\ud1b5\uacc4\ub294 \uacbd\uae30 \uc9c1\ud6c4 \uc989\uc2dc \uc7ac\uacc4\uc0b0\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ucd5c\ub300 24\uc2dc\uac04\uc774 \uac78\ub9bd\ub2c8\ub2e4.\",KK=\"\ucd5c\ub300 \ubc30\ub2f9\ub960 \uc608\uce21\",XK='\"\ub9ac\uadf8\ubcc4 ROI\"\ub294 \ud2b9\uc815 \ub9ac\uadf8\ubcc4 \uc0ac\uc6a9\uc790\uc608\uce21 ROI\ud1b5\uacc4\ub97c \ud45c\uc2dc\ud569\ub2c8\ub2e4.',eX=\"\ud604\uc7ac \uc774\uc6a9\uac00\ub2a5\ud55c \ucd5c\uace0 \ud578\ub514\ucea1\uc774 \uc5c6\uc2b5\ub2c8\ub2e4. \ub098\uc911\uc5d0 \ub2e4\uc2dc \ud655\uc778\ud574 \uc8fc\uc138\uc694.\",tX=\"\ub2e4\uc74c 12\uc2dc\uac04\",oX=\"\uadc0\ud558\uc758 \uba54\uc2dc\uc9c0\uc5d0 \uac10\uc0ac\ub4dc\ub9bd\ub2c8\ub2e4. (\ud544\uc694\uc2dc) \ucd5c\ub300\ud55c \ube68\ub9ac \ub2f5\ubcc0 \ub4dc\ub9ac\uaca0\uc2b5\ub2c8\ub2e4.\",nX=\"\uc751\ub2f5\uc744 \ubcf4\ub0b4\ub294 \uc911\uc5d0 \uc5d0\ub7ec\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4. \ub098\uc911\uc5d0 \uc7ac\uc2dc\ub3c4\ud574 \uc8fc\uc138\uc694.\",sX=\"\ud398\uc774\uc9c0\uc5d0 \uc624\ub958\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4. \ub098\uc911\uc5d0 \uc7ac\uc2dc\ub3c4\ud574 \uc8fc\uc138\uc694.\",aX=\"\ucd5c\uadfc 1\uc2dc\uac04\",rX=\"\ucd5c\uadfc 12\uc2dc\uac04\",iX=\"\ucd5c\uadfc 24\uc2dc\uac04\",cX=\"\ud558\ub77d\ud558\ub294 \ubd81\uba54\uc774\ucee4\",lX=\"\ubaa8\ub4e0 \uc720\ud615\",_X=\"\uc5b4\ub5a4 \ubc30\ub2f9\ub960\",dX=\"\uac12\",uX=\"\uacbd\uae30 \ub354\ubcf4\uae30\",pX=\"\uc885\ubaa9 \ub354\ubcf4\uae30\",mX=\"\ub354\ubcf4\uae30\",fX=\"\ud574\ub2f9 \uc774\uba54\uc77c\uc774 \uc874\uc7ac\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\",gX=\"\uac10\uc0ac\ud569\ub2c8\ub2e4. \ucd94\uac00 \uc815\ubcf4\ub97c \uadc0\ud558\uc758 \uc774\uba54\uc77c\ub85c \ubcf4\ub0b4\ub4dc\ub838\uc2b5\ub2c8\ub2e4.\",hX=\"\ud65c\uc131\ud654 \ucf54\ub4dc\uac00 \uadc0\ud558\uc758 \uc774\uba54\uc77c\ub85c \uc804\uc1a1\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\",yX=\"\uce5c\uc560\ud558\ub294\",bX=\"\ube44\ubc00\ubc88\ud638\uac00 \uc131\uacf5\uc801\uc73c\ub85c \ubcc0\uacbd\ub418\uc5c8\uc2b5\ub2c8\ub2e4!\",vX=\"\ucd5c\uace0\uc758 \ubca0\ud305,\",wX=\"\uc624\uc988\ud3ec\ud0c8\ub2f7\ucef4 \ud300\",CX=\"\ube44\ubc00\ubc88\ud638 \ubd84\uc2e4 - \ube44\ubc00\ubc88\ud638 \ubcc0\uacbd\",AX=\"\ud604\uc7ac \ub370\uc774\ud130\uac00 \uc5c6\uc2b5\ub2c8\ub2e4.\",kX=\"\uc228\uae30\uae30\",IX=\"\ubaa8\ub4e0 \uc885\ubaa9\",TX=\"\ud604\uc7ac \uc9c4\ud589\uc911\",xX=\"\uc608\uc815\",EX=\"1\uc6d4\",SX=\"2\uc6d4\",PX=\"3\uc6d4\",OX=\"4\uc6d4\",$X=\"5\uc6d4\",NX=\"6\uc6d4\",zX=\"6\uc6d4\",jX=\"7\uc6d4\",MX=\"7\uc6d4\",LX=\"8\uc6d4\",BX=\"9\uc6d4\",RX=\"10\uc6d4\",DX=\"11\uc6d4\",HX=\"12\uc6d4\",UX=\"\uc624\ub298 \uacbd\uae30 \ubcf4\uae30\",FX=\"\ud0a5\uc624\ud504 \ud0c0\uc784\",QX=\"\uc774\ubca4\ud2b8\",GX=\"\uc774 \uc139\uc158\uc5d0\uc11c\ub294 \uc608\uc815\uacbd\uae30 \ub370\uc774\ud130\uc640 \ucd5c\uadfc 30\uc77c \ub3d9\uc548 \uc9c4\ud589\ub41c \uacbd\uae30\ub4e4\uc758 \uacb0\uacfc\uac00 \uc81c\uacf5\ub429\ub2c8\ub2e4. \uc9c0\ub09c \uacb0\uacfc\uc5d0 \uad00\uc2ec\uc774 \uc788\ub2e4\uba74 \ubc29\ubb38\ud558\uc138\uc694. \",WX=\"\uacbd\uae30\uacb0\uacfc \uc544\uce74\uc774\ube0c\",VX=\"\ud574\ub2f9 \uacbd\uae30\uac00 \uc5c6\uc2b5\ub2c8\ub2e4\",qX=\"\ub9c8\uc774 \ub9e4\uce58 \uc139\uc158\uc5d0\ub294 \ub9c8\uc774\ub9ac\uadf8 \uacbd\uae30\ub4e4\uc774 \ud45c\uc2dc\ub418\uc9c0\ub9cc \uc544\uc9c1 \ub9c8\uc774\ub9ac\uadf8\ub97c \uc120\ud0dd\ud558\uc9c0 \uc54a\uc73c\uc168\uc2b5\ub2c8\ub2e4. \ub9c8\uc774\ub9ac\uadf8\ub97c \uad00\ub9ac\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4 \",YX=\"\uc8c4\uc1a1\ud569\ub2c8\ub2e4. \uc54c \uc218 \uc5c6\ub294 \uc694\uccad\uc785\ub2c8\ub2e4!\",JX=\"\uc548\ud0c0\uae5d\uac8c\ub3c4 \uc120\ud0dd\ud558\uc2e0 \ubd81\ub9c8\ud06c\uc5d0\uc11c \uc0ac\uc6a9\uac00\ub2a5\ud55c \ubc30\ub2f9\ub960\uc774 \uc5c6\uc5b4\uc11c \ud45c\uc2dc\ud560 \uacbd\uae30\uac00 \uc5c6\uc2b5\ub2c8\ub2e4.\",ZX=\"\ubaa8\ub4e0 \ub2e4\uc74c \uacbd\uae30\",KX=\"\ubb34\uc5c7\uc778\uac00 \uc798\ubabb\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\",XX=\"\ud604\uc7ac \uc608\uc815\ub41c \uacbd\uae30\uac00 \uc5c6\uc2b5\ub2c8\ub2e4\",eee=\"\uadc0\ud558\uac00 \uc815\uc758\ud55c.\",tee=\"\ubaa8\ub4e0 \ub9c8\uc774 \ub9e4\uce58\",oee=\"\uc774 \ud398\uc774\uc9c0\uc5d0 \uc811\uadfc\ud558\ub824\uba74.\",nee=\"\uc544\uc9c1 \uacc4\uc815\uc774 \uc5c6\uc73c\uc2dc\ub2e4\uba74 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\",see=\"\ucd5c\uadfc \uc54c\ub9bc \uc5c6\uc74c\",aee=\"\ub85c\uadf8\uc778 \ud574\uc8fc\uc138\uc694!\",ree=\"\uc8c4\uc1a1\ud569\ub2c8\ub2e4. \uc11c\ubc84\uc5d0 \ubb38\uc81c\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4! \ub098\uc911\uc5d0 \ub2e4\uc2dc \uc2dc\ub3c4\ud574\uc8fc\uc138\uc694!\",iee=\"\uc54c\ub9bc\",cee=\"\ubaa8\ub4e0 \uc54c\ub9bc \ud45c\uc2dc\",lee=\"\uc774 \uc0ac\uc6a9\uc790\uc5d0 \ub300\ud55c \uc54c\ub9bc\uc744 \ubc1b\uc73c\uc2dc\ub824\uba74 \ud314\ub85c\uc6b0\ud558\uc154\uc57c \ud569\ub2c8\ub2e4!\",_ee=\"\uc624\uc988\ud3ec\ud0c8 \ucee4\ubba4\ub2c8\ud2f0\uc640 \ubca0\ud305\uc744 \uacf5\uc720\ud558\uace0 \ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc758 \uc608\uce21\uc744 \ud655\uc778\ud558\uc138\uc694. \uc608\uce21\uc744 \ud558\uc2dc\ub824\uba74 \ubc30\ub2f9\ub960 \uc544\ub798 \ube44\uc728\ub9c9\ub300\ub97c \ud074\ub9ad\ud558\uc2dc\uba74 \ub429\ub2c8\ub2e4. \ud5a5\ud6c4 7\uc77c \ub3d9\uc548\uc758 top \uc0ac\uc6a9\uc790 \uc608\uce21\uc740 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4.\",dee=\"Top\uc608\uce21 \uc544\uce74\uc774\ube0c \ubcf4\uae30\",uee=\"\ub313\uae00 ->\uc81c\uac70\ub85c \uc778\ud574 \ube48 \uc5f4\uc774 \ud45c\uc2dc\ub429\ub2c8\ub2e4!\",pee=\"\uc11c\ubc84 %s \uac00 \uc624\uc988\ud3ec\ud0c8\ub2f7\ucef4 \ub4f1\ub85d\uc5d0 \uc774\uc6a9\ub420 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.\",mee=\"\ud574\ub2f9 \ud398\uc774\uc9c0\uc5d0\uc11c \ub370\uc774\ud130\ubca0\uc774\uc2a4 \ub610\ub294 \uba54\uc77c\uc804\uc1a1 \uc5d0\ub7ec\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4. \ub098\uc911\uc5d0 \uc2dc\ub3c4\ud558\uc138\uc694.\",fee=\"CAPTCHA \uc778\uc99d\uc5d0 \uc2e4\ud328\ud588\uc2b5\ub2c8\ub2e4. \uc7ac\uc2dc\ub3c4\ud558\uc138\uc694.\",gee=\"\uc624\uc988\ud3ec\ud0c8\ub2f7\ucef4\uc5d0 \uac00\uc785\ud574\uc8fc\uc154\uc11c \uac10\uc0ac\ud569\ub2c8\ub2e4. \uac00\uc785\uc744 \uc644\ub8cc\ud558\ub824\uba74 \uc544\ub798 \ud65c\uc131\ud654\ub9c1\ud06c\ub97c \ud074\ub9ad\ud558\uc138\uc694.\",hee=\"\ud65c\uc131\ud654 \uc8fc\uc18c:\",yee=\"\ud655\uc778 \ub9c1\ud06c\uac00 \uc791\ub3d9\ud558\uc9c0 \uc54a\uc73c\uba74, \uc778\uc99d\ucf54\ub4dc\ub97c \uc785\ub825\ud558\uc138\uc694\",bee=\"\ub85c\uadf8\uc778 \ud6c4 \ub354 \ub098\uc740 \uc11c\ube44\uc2a4\ub97c \ubc1b\uc73c\uc2dc\uae30 \uc704\ud574 \uc124\uc815\uc744 \uac1c\uc778\ud654\ud558\ub294 \uac83\uc744 \uc78a\uc9c0 \ub9c8\uc138\uc694.\",vee=\"\ub2e4\uc74c \uc8fc\uc18c\uc5d0\uc11c:\",wee=\"\uc624\uc988\ud3ec\ud0c8 \uc11c\ube44\uc2a4\uc5d0 \uad00\uc2ec \uac00\uc838\uc8fc\uc154\uc11c \uac10\uc0ac\ud569\ub2c8\ub2e4!\",Cee=\"\ud589\uc6b4\uc744 \ube55\ub2c8\ub2e4,\",Aee=\"\uac00\uc785 \ud655\uc778 - \uc9c0\uae08 \uc774\uba54\uc77c\uc744 \ud655\uc778\ud558\uc138\uc694\",kee=\"\ub4f1\ub85d\uc744 \uc644\ub8cc\ud558\ub824\uba74 \uc774\uba54\uc77c\uc744 \ud655\uc778\ud558\uace0 \uc800\ud76c\uac00 \ubcf4\ub0b4\ub4dc\ub9b0 \ub9c1\ud06c\ub97c \ud074\ub9ad\ud558\uc5ec \uc0c8 \uacc4\uc815\uc744 \ucee8\ud38c\ud558\uc138\uc694.\",Iee=\"\ub85c\uadf8\uc778/\uc560\ud50c\",Tee=\"\uc774\uc720\",xee=\"\ucd94\uac00 \uc815\ubcf4 \uc81c\uacf5 (\uc120\ud0dd)\",Eee=\"\uc798\ubabb\ub41c \ub370\uc774\ud130\",See=\"\uc2e0\uace0\uac00 \uc804\uc1a1\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\",Pee=\"\uc2e0\uace0 \uc2e4\ud328. \ub098\uc911\uc5d0 \uc2dc\ub3c4\ud558\uc138\uc694.\",Oee=\"\uc544\uce74\uc774\ube0c \ubc30\ub2f9\ub960 \uac80\uc0c9\",$ee=\"\ub2e4\uc74c \uacbd\uae30 \uac80\uc0c9\",Nee=\"\uac80\uc0c9\uc5b4\uac00 \ub108\ubb34 \uc9e7\uc2b5\ub2c8\ub2e4 (\ucd5c\uc18c 3\uae00\uc790).\",zee=\"\uae30\uc900\uc744 \ubcc0\uacbd\ud558\uace0 \uc7ac\uc2dc\ub3c4\ud574 \ubcf4\uc138\uc694.\",jee=\"\ud604\uc7ac \uac80\uc0c9\uc774 \ubd88\uac00\ud569\ub2c8\ub2e4. \ub098\uc911\uc5d0 \uc7ac\uc2dc\ub3c4\ud574 \uc8fc\uc138\uc694.\",Mee=\"\ud574\ub2f9 \uac80\uc0c9\uc5d0 \ub9de\ub294 \uc608\uc815 \uacbd\uae30\uac00 \uc5c6\uc2b5\ub2c8\ub2e4. \uc800\ud76c\uc758 \ubc30\ub2f9\ub960 \uc544\uce74\uc774\ube0c\uc5d0\uc11c \uadc0\ud558\uc758 \uc120\ud0dd\uc5d0 \ub9de\ub294 \ubc30\ub2f9\uae30\ub85d\uc744 \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\",Lee=\"\ub2e4\uc74c \uacbd\uae30\",Bee=\"\uc544\ub098\uae5d\uac8c\ub3c4, \uc774\uc6a9 \uac00\ub2a5\ud55c \uc774\uc804 \uacbd\uae30\uc790\ub8cc\uac00 \uc5c6\uc5b4\uc11c \ud45c\uc2dc\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.\",Ree=\"W\",Dee=\"\uc608\uc815 \uacbd\uae30\",Hee=\"\ud604\uc7ac \ub4f1\ub85d\ub41c \ubd81\uba54\uc774\ucee4\ub4e4\uc774 \uc81c\uacf5\ud558\ub294 %s \uc608\uc815\uacbd\uae30\uac00 \uc5c6\uc2b5\ub2c8\ub2e4.\",Uee=\"\ubd81\uba54\uc774\ucee4\uc758 \ubc30\ub2f9\ub960\uc774 \uc81c\uacf5\ub418\ub294 \uc989\uc2dc \ub2e4\uc74c \uacbd\uae30\uac00 \uc5ec\uae30\uc5d0 \ud45c\uc2dc\ub429\ub2c8\ub2e4.\",Fee=\"\uc544\uc6c3\ub77c\uc774\ud2b8\",Qee=\"\ud398\uc774\uc9c0\",Gee=\"\ud300\",Wee=\"\ubd81\uba54\uc774\ucee4 \ubc30\ub2f9\ub960\uc774 \uc81c\uacf5\ub418\ub294 \uc989\uc2dc \uc544\uc6c3\ub77c\uc774\ud2b8\uac00 \uc5ec\uae30\uc5d0 \ud45c\uc2dc\ub429\ub2c8\ub2e4.\",Vee=\"\uc8c4\uc1a1\ud558\uac8c\ub3c4, \uc694\uccad\ud558\uc2e0 \ub9ac\uadf8\ub294 \uc9c0\uc6d0\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4!\",qee=\"\uc548\ub155\ud558\uc138\uc694,\",Yee=\"\uacc4\uc815\uc774 \uc131\uacf5\uc801\uc73c\ub85c \uc0ad\uc81c\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uadc0\ud558\uc758 \uc5b4\ub5a4 \ub370\uc774\ud130\ub3c4 \ub354 \uc774\uc0c1 \uc800\uc7a5\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc124\uc815 \ubc0f \uc990\uaca8\ucc3e\uae30 \ud300\uacfc \ub300\ud68c\ub97c \ubcf5\uc6d0\ud560 \uc218 \uc5c6\uc9c0\ub9cc, \uc7ac\uac00\uc785 \uc2dc \ub3d9\uc77c \uc774\uba54\uc77c \uc8fc\uc18c\ub85c \uc0c8 \uacc4\uc815\uc744 \ub9cc\ub4e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\",Jee=\"\uadc0\ud558\uc758 \ud589\uc6b4\uc744 \ube4c\uba70, \uc5b8\uc820\uac00 \ub2e4\uc2dc \ub9cc\ub0a0 \uc218 \uc788\uae30\ub97c \uae30\uc6d0\ud569\ub2c8\ub2e4!\",Zee=\"\uc624\uc988\ud3ec\ud0c8\ub2f7\ucef4 \ud300\",Kee=\"\uacc4\uc815\uc774 \uc0ad\uc81c\ub428\",Xee=\"\ucc38\uace0\ub97c \uc704\ud574 \uadc0\ud558\uc758 \ub85c\uadf8\uc778 \uc815\ubcf4\ub97c \uc548\uc804\ud55c \uacf3\uc5d0 \uc800\uc7a5\ud574 \ub450\uc138\uc694:\",ete=\"\uadc0\ud558\uc758 \uc0ac\uc6a9\uc790\uc774\ub984:\",tte=\"\uc624\uc988\ud3ec\ud0c8\ub2f7\ucef4 \ubb34\ub8cc\uac00\uc785\uc744 \uc6d0\ud558\uc9c0 \uc54a\uc73c\uc2e4 \uacbd\uc6b0, \uc544\ub798 \ucde8\uc18c\ub9c1\ud06c\ub97c \ud074\ub9ad\ud558\uc2dc\uba74 \uadc0\ud558\uc758 \uac00\uc785\uc774 \uc989\uc2dc \ucde8\uc18c\ub429\ub2c8\ub2e4.\",ote=\"\ucde8\uc18c \ub9c1\ud06c\uac00 \uc791\ub3d9\ud558\uc9c0 \uc54a\uc73c\uba74, \ucf54\ub4dc\ub97c \uc785\ub825\ud574\uc8fc\uc138\uc694\",nte=\"\uc624\uc988\ud3ec\ud0c8\ub2f7\ucef4 \uacc4\uc815\uc744 \ud65c\uc131\ud654\ud558\uc138\uc694\",ste=\"\ub77c\uc6b0\ud130\",ate=\"\uadc0\ud558\uc758 \uacc4\uc815\uc744 \uc601\uad6c\uc801\uc73c\ub85c \uc81c\uac70\ud558\uace0\",rte=\"\ubaa8\ub4e0 \uc124\uc815\uc744 \uc0ad\uc81c\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c\",ite=\"\ucfe0\ud3f0\uc744 \uc800\uc7a5\ud558\uba74 \ucfe0\ud3f0 \uacb0\uacfc\uac00 \ud3ec\ud568\ub41c \uc774\uba54\uc77c\uc744 \ubc1b\uac8c \ub429\ub2c8\ub2e4.\",cte=\"\ucfe0\ud3f0\uc5d0\uc11c \ubaa8\ub4e0 \uacbd\uae30 \uc0ad\uc81c\",lte=\"\uc608\uce21\uc73c\ub85c \uc800\uc7a5\",_te=\"\ucfe0\ud3f0\uc744 \uc800\uc7a5\ud558\uace0 \uacf5\uc720\ud558\ub824\uba74 \ub85c\uadf8\uc778\ud558\uc138\uc694.\",dte=\"\ub0b4 \uc800\uc7a5 \ucfe0\ud3f0\",ute=\"\uac1c\uc778 \ubc30\ub2f9\ub960\",pte=\"\ubaa8\ub4e0 \ubd81\uba54\uc774\ucee4 \ube44\uad50\",mte=\"\uc774 \uc870\ud569\uc758 \ubc30\ub2f9\ub960\uc744 \uc81c\uacf5\ud558\ub294 \ubd81\uba54\uc774\ucee4\uac00 \uc5c6\uc2b5\ub2c8\ub2e4.\",fte=\"\uacbd\uae30\",gte=\"\ud604\uc7ac \ucc28\ub2e8\ub41c \ubc30\ub2f9\ub960\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.\",hte=\"\ubaa8\ub4e0 \ucc28\ub2e8\ubc30\ub2f9\ub960\",yte=\"Top\uc608\uce21 \ub354\ubcf4\uae30\",bte=\"\ucd5c\uadfc Top\uc608\uce21\uc774 \uc5c6\uc2b5\ub2c8\ub2e4\",vte=\"\ud65c\uc131 \ubc30\ub2f9\ub960\uc774 \uc5c6\ub294 \ud301\",wte=\"\uc608\uce21\uc774 \uc800\uc7a5\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\",Cte=\"\uc774 \ud301\uc744 \uc774\ubbf8 \uc608\uce21\ud558\uc168\uc2b5\ub2c8\ub2e4\",Ate=\"\uba87 \uac00\uc9c0 \ud301\",kte=\"\ud301\",Ite=\"\ub2e4\uc74c \uc624\ub958\ub85c \uc778\ud574 \uc800\uc7a5\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4\",Tte=\"\uc608\uce21 \uce5c\uad6c\ub97c \uad6c\ud558\uc2dc\ub824\uba74 \ub85c\uadf8\uc778\ud558\uc138\uc694\",xte=\"\uc608\uc815 \uacbd\uae30\",Ete=\"\ub300\ud68c\",Ste=\"\ubc30\ub2f9\ub960 \uc544\uce74\uc774\ube0c\",Pte=\"\ubcf4\ud1b5\uc758\",Ote=\"\uadc0\ud558\uc758 \uae30\uc900\uc5d0 \ub9de\ub294 \ucc28\ub2e8\ubc30\ub2f9\ub960\uc774 \uc5c6\uc2b5\ub2c8\ub2e4. \uc704 \ud544\ud130\uc758 \uac12\uc744 \ubcc0\uacbd\ud558\uc138\uc694.\",$te=\"\ud3c9\uade0 \ucd08\uae30\ubc30\ub2f9\ub960:\",Nte=\"\ud3c9\uade0 \ub9c8\uac10\ubc30\ub2f9\ub960:\",zte=\"\ub610\ub294 \uadf8 \uc774\uc0c1\",jte=\"\ud504\ub9ac\ubbf8\uc5c4 \ubd81\uba54\uc774\ucee4\ub9cc \ud45c\uc2dc\ub429\ub2c8\ub2e4.\",Mte=\"\ub354 \ub9ce\uc740 \ubd81\uba54\uc774\ucee4\ub97c \ubcf4\uc2dc\ub824\uba74 \ud074\ub9ad\ud558\uc138\uc694\",Lte=\"\ubcf4\ub108\uc2a4 \ud61c\ud0dd\uc744 \ubcf4\uc2dc\ub824\uba74 \ub85c\uadf8\uc778\ud558\uc138\uc694\",Bte=\"\ud3c9\uac00\ud558\ub824\uba74 \uc5ec\uae30\ub97c \ub204\ub974\uc138\uc694\",Rte=\"\ud3c9\uac00\ud558\ub824\uba74 \ub85c\uadf8\uc778\ud558\uc138\uc694\",Dte=\"\ube44\ud68c\uc6d0\uc5d0\uac8c\ub294 \ubd81\uba54\uc774\ucee4\uac00 \uc81c\uacf5\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4\",Hte=\"\uc9c0\uae08!\",Ute=\"\ubd81\uba54\uc774\ucee4 \ub354 \ubcf4\uae30!\",Fte=\"\ubd81\uba54\uc774\ucee4 \ub354 \ubcf4\uae30!\",Qte=\"\ubd81\uba54\uc774\ucee4\",Gte=\"\ud504\ub9ac\ubbf8\uc5c4\ub9cc\",Wte=\"\ud45c\uc2dc\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ubcf4\uc2dc\ub824\uba74 \ud074\ub9ad\ud558\uc138\uc694\",Vte=\"\ud3c9\uac00\ub97c \ubcf4\uc2dc\ub824\uba74 \ub85c\uadf8\uc778\ud558\uc138\uc694!\",qte=\"\ud504\ub791\uc2a4\",Yte=\"\uc774\ud0c8\ub9ac\uc544\",Jte=\"\uccb4\ucf54\",Zte=\"\uc2ac\ub85c\ubc14\ud0a4\uc544\",Kte=\"\ud3ec\ub974\ud22c\uac08\",Xte=\"\uc2a4\ud398\uc778\",eoe=\"\ud130\ud0a4\",toe=\"\uce90\ub098\ub2e4\",ooe=\"\ub7ec\uc2dc\uc544\",noe=\"\ud3f4\ub780\ub4dc\",soe=\"\uc601\uad6d\",aoe=\"\uadc0\ud558\uc758 \ubd80\ud0a4\ud30c\uc778\ub354 \uae30\uc900\uacfc \uc77c\uce58\ud558\ub294 \ubd81\uba54\uc774\ucee4\uac00 \uc5c6\uc2b5\ub2c8\ub2e4. \uc870\uac74\uc744 \uc904\uc5ec\uc11c \uc7ac\uac80\uc0c9\ud558\uc138\uc694.\",roe=\"\ubaa8\ub4e0 \ud56b\ub9e4\uce58\",ioe=\"\ub77c\uc774\ube0c\",coe=\"\ud604\uc7ac \ubd81\uba54\uc774\ucee4\uac00 \uc81c\uacf5\ud558\ub294 \uc778\ud50c\ub808\uc774 \ubc30\ub2f9\ub960\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.\",loe=\"\uc8fc\uc694/\ub2e4\uc74c-\uacbd\uae30-\ub77c\uc774\ube0c\",_oe=\"\ubaa8\ub4e0 \uc778\ud50c\ub808\uc774 \ubc30\ub2f9\ub960\",doe=\"\uc8fc\uc694 \uacbd\uae30\",uoe=\"\ubaa8\ub4e0 \uacbd\uae30\",poe=\"\ube44\ud65c\uc131\",moe=\"\ud65c\uc131\",foe=\"\uadc0\ud558\uc758 \uae30\uc900\uc5d0 \ub9de\ub294 \ud558\ub77d\ubc30\ub2f9\ub960\uc774 \uc5c6\uc2b5\ub2c8\ub2e4. \uc704 \ud544\ud130\uc758 \uac12\uc744 \ubcc0\uacbd\ud558\uc138\uc694.\",goe=\"\ud558\ub77d\",hoe=\"\uc548\ud0c0\uae5d\uac8c\ub3c4, \uadc0\ud558\uc758 \uc9c0\uc5ed\uc5d0\ub294 \ud480\uc11c\ube44\uc2a4 \uc81c\uacf5\uc774 \ubc95\uc801\uc73c\ub85c \uae08\uc9c0\ub3fc \uc788\uc2b5\ub2c8\ub2e4.\",yoe=\"\ud604\uc7ac \ubd81\uba54\uc774\ucee4\uac00 \uc81c\uacf5\ud558\ub294 \uc2e4\uc2dc\uac04 \uacbd\uae30 \ubc30\ub2f9\ub960\uc774 \uc5c6\uc2b5\ub2c8\ub2e4. \ud655\uc778\ud558\uc138\uc694\",boe=\"\uc608\uc815\ub41c \uc778\ud50c\ub808\uc774\uac00 \uc5c6\uc2b5\ub2c8\ub2e4.\",voe=\"\ud578\ub514\ucea1\",woe=\"\uc544\uce74\uc774\ube0c\",Coe=\"\ud65c\ub3d9\",Aoe=\"\ud544\uc218 \ubc30\ub2f9\ub960\",koe=\"\uc5c5\ub370\uc774\ud2b8 \ub300\uae30 \uc911\",Ioe=\"\uc774\ud6c4\",Toe=\"\uc5f0\uc7a5\ud3ec\ud568 \ud480\ud0c0\uc784\",xoe=\"\uc5f0\uc7a5\",Eoe=\"\ud480\ud0c0\uc784\",Soe=\"\ub2e4\uc74c \uc138\ud2b8\",Poe=\"\ud604\uc7ac \uc138\ud2b8\",Ooe=\"\ub2e4\uc74c \uacbd\uae30\",$oe=\"\uc774\ub2dd\",Noe=\"\ubd81\uba54\uc774\ucee4 \uc774\ub984\",zoe=\"\ubd81\uba54\uc774\ucee4 \uc9c0\ubd88\uc561\",joe=\"\uc120\uc218\uac00 \uc5c6\uc2b5\ub2c8\ub2e4.\",Moe=\"\uad6d\uc801\",Loe=\"\ud3ec\uc9c0\uc158\",Boe=\"\uc2dc\uc98c \uc885\ub8cc \ub54c \ub3d9\uc77c \uc2b9\uc810\uc774\uba74 \ub4dd\uc810\ucc28\ub85c \uc21c\uc704\uac00 \uacb0\uc815\ub429\ub2c8\ub2e4.\",Roe=\"\ub3d9\uc77c \uc2b9\uc810\uc73c\ub85c \ub300\ud68c\ub97c \ub9c8\uce58\uba74, \ub9de\ub300\uacb0 \uacb0\uacfc\ub85c \uc21c\uc704\uac00 \uacb0\uc815\ub429\ub2c8\ub2e4.\",Doe=\"\uacbd\uae30 \uc5c6\uc74c\",Hoe=\"\ud574\ub2f9 \uae30\uac04 \uacbd\uae30 \uc5c6\uc74c\",Uoe=\"\ub2e4\uc74c 7\uc77c\",Foe=\"\uc288\uc5b4\ubcb3 \ub354\ubcf4\uae30\",Qoe=\"\ud604\uc7ac \ubc30\ub2f9\ub960\uc758 \ubd81\uba54\uc774\ucee4\ub97c \ud655\uc778\ud558\uc138\uc694!\",Goe=\"\ucd5c\uadfc \uc288\uc5b4\ubcb3 \uc5c5\ub370\uc774\ud2b8: 1\uc2dc\uac04 \uc774\uc0c1 \uc804\",Woe=\"\uc720\ud6a8\ud558\uc9c0 \uc54a\uc740 \uc774\ubca4\ud2b8ID\",Voe=\"\uc720\ud6a8\ud558\uc9c0 \uc54a\uc740 \ubca0\ud305\uc720\ud615\",qoe=\"\uc720\ud6a8\ud558\uc9c0 \uc54a\uc740 \ubc94\uc704\",Yoe=\"\ud604\uc7ac \uc288\uc5b4\ubcb3\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.\",Joe=\"\uacb0\uacfc\",Zoe=\"\uc9c0\ubd84\",Koe=\"\uc0c1\uae08\",Xoe=\"\uc704\ud5d8\uc744 \uac10\uc218\ud558\ub824\ub294 \ucd1d \uae08\uc561:\",ene=\"\uacc4\uc0b0\ud558\uae30\",tne=\"\uadc0\ud558\uc758 \uc774\uc775\",one=\"\ubaa8\ub4e0 \uc9c0\ubd84\uc744 \ubc18\uc62c\ub9bc\",nne=\"\uae30\ubcf8 \uc885\ubaa9\",sne=\"\uadc0\ud558\uc758 \uae30\uc900\uc5d0 \ub9de\ub294 \ubc38\ub958\ubcb3\uc774 \uc5c6\uc2b5\ub2c8\ub2e4. \uc704 \ud544\ud130\uc758 \uac12\uc744 \ubcc0\uacbd\ud558\uc138\uc694.\",ane=\"\ucd5c\uadfc 30\uc77c\uac04 \ucc98\ub9ac\ub41c 1X2 \ubc30\ub2f9\ub960\ub85c \uacc4\uc0b0\ub428.\",rne=\"\ucd5c\uadfc 30\uc77c\uac04 \ucc98\ub9ac\ub41c \ud648/\uc6d0\uc815 \ubc30\ub2f9\ub960\ub85c \uacc4\uc0b0\ub428.\",ine=\"\ud3c9\uade0 \uc778\ud50c\ub808\uc774 \ubc30\ub2f9\ub960 \uc9c0\ubd88\uc561\",cne=\"\ud3c9\uade0 \uc9c0\ubd88\uc561\",lne=\"\ud3c9\uade0 \uc9c0\ubd88\uc561\uc744 \ud655\uc778\ud558\ub824\uba74 \ub85c\uadf8\uc778\ud558\uc138\uc694!\",_ne=\"\ud574\ub2f9 \uc0ac\uc6a9\uc790\",dne=\"\uc798\ubabb\ub41c \uc18c\uc720\uc790 \uc720\ud615\uc785\ub2c8\ub2e4!\",une=\"\ub313\uae00\uc744 \ub2ec\uc558\uc2b5\ub2c8\ub2e4\",pne=\"\ubc29\uae08 \uc608\uce21\ub418\uc5c8\uc2b5\ub2c8\ub2e4\",mne=\"\uc548\ud0c0\uae5d\uac8c\ub3c4, \uadc0\ud558\uc758 \uae30\uc900\uacfc \uc77c\uce58\ud558\ub294 \ud65c\uc131 \uc0ac\uc6a9\uc790\uac00 \uc5c6\uc2b5\ub2c8\ub2e4. \uc704 \ud544\ud130\uc758 \uac12\uc744 \ubcc0\uacbd\ud558\uc138\uc694.\",fne=\"\ud504\ub85c\ud544\uc0ac\uc9c4\",gne=\"\ub0b4 \uc608\uce21\",hne=\"\ub0b4 \ud1b5\uacc4\",yne=\"\ub85c\uadf8\uc544\uc6c3\",bne=\"\uc548\ud0c0\uae5d\uac8c\ub3c4 \uc0c1\uc704 \uad6d\uac00\uac00 \uc5c6\uc2b5\ub2c8\ub2e4.\",vne=\"\uc77c \uc81c\ud55c\uc5d0 \uac78\ub838\uc2b5\ub2c8\ub2e4. \ub0b4\uc77c \ub354 \ub9ce\uc740 \uc54c\ub9bc\uc744 \uc124\uc815\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\",wne=\"\ucfe0\ud3f0\uc744 \uc800\uc7a5\ud558\ub294 \ub3c4\uc911 \uc624\ub958\uac00 \ubc1c\uc0dd\ud588\uc2b5\ub2c8\ub2e4. \ub2e4\uc2dc \uc2dc\ub3c4\ud558\uc138\uc694.\",Cne=\"\uc120\ud0dd\ud558\uc2e0 \uacbd\uae30\uc5d0\ub294 \ubd81\uba54\uc774\ucee4\uac00 \uc5c6\uc2b5\ub2c8\ub2e4 / \uc870\ud569\uc740 \ud5c8\uc6a9\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4\",Ane=\"\ucfe0\ud3f0\uc774 \uc800\uc7a5\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4! \ucd5c\ub300 \ud3c9\uade0\ubc30\ub2f9\ub960\uc774 100\ub9cc \ubbf8\ub9cc\uc774 \ub418\ub3c4\ub85d \ucfe0\ud3f0\uc744 \ub098\ub220\ubcf4\uc138\uc694.\",kne=\"\uc8c4\uc1a1\ud569\ub2c8\ub2e4. \uc774 \uacb0\uacfc\uc5d0\ub294 \ud65c\uc131 \ubca0\ud305 \uc81c\uc548\uc774 \uc5c6\uc2b5\ub2c8\ub2e4!\",Ine=\"\uc8c4\uc1a1\ud569\ub2c8\ub2e4. \uc774 \ub300\ud68c\ub294 \uc885\ub8cc\ub418\uc5c8\uc2b5\ub2c8\ub2e4!\",Tne=\"\uc774\ubbf8 \uc2dc\uc791\ub41c \uacbd\uae30\uc758 \uc608\uce21\uc740 \uc0ad\uc81c\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4\",xne=\"60\ucd08 \ud6c4\uc5d0\ub294 \uc608\uce21\uc744 \ubcc0\uacbd\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.\",Ene=\"\uc2a4\ub9ac\uc790\uc57c\uc640\ub974\ub370\ub098\ud478\ub77c\",Sne=\"\uc2dc\uac04\ub300\ub97c \uc120\ud0dd\ud558\uc138\uc694\",Pne=\"\ud3ec\uc778\ud2b8 \uc2b9\ub9ac\",One=\"\uad6c\uc131\",$ne=\"\ubc30\ub2f9\ub960 \ube44\uad50\",Nne=\"\ucee4\ubba4\ub2c8\ud2f0\",zne=\"\ub77c\uc774\ube0c \uc2a4\ucf54\uc5b4\",jne=\"\ubd81\uba54\uc774\ucee4\",Mne=\"\ud648\",Lne=\"\ub2e4\uc74c \uacbd\uae30\",Bne=\"\ud558\ub77d \ubc30\ub2f9\ub960\",Rne=\"\uc288\uc5b4\ubcb3\",Dne=\"\uc778\ud50c\ub808\uc774 \ubc30\ub2f9\ub960\",Hne=\"\ubaa8\ub4e0 \uacbd\uae30\",Une=\"\ubca0\ud305 \ud234\",Fne=\"\uac80\uc0c9 (\ud300 / \uc120\uc218)\",Qne=\"\ubc38\ub958\ubcb3\",Gne=\"\ud56b\ub9e4\uce58\",Wne=\"\ubc30\ub2f9\ub960 \ud615\uc2dd\",Vne=\"\uc2dc\uac04\ub300:\",qne=\"\ub85c\uadf8\uc778\",Yne=\"\ud68c\uc6d0\uac00\uc785\",Jne=\"Top \uc608\uce21\",Zne=\"\ub0b4 \uc608\uce21\",Kne=\"\ub0b4 \ucfe0\ud3f0\",Xne=\"\ub0b4 \ud504\ub85c\ud544\",ese=\"\ub0b4 \ud1b5\uacc4\",tse=\"\uc0ac\uc6a9\uc790\",ose=\"\ud53c\ub4dc\",nse=\"\ud558\ub77d\",sse=\"\ucc28\ub2e8\",ase=\"\ubc38\ub958\",rse=\"\ubcb3\",ise=\"\ud56b\",cse=\"\ub9e4\uce58\",lse=\"\uc544\uce74\uc774\ube0c\",_se=\"\uacb0\uacfc\",dse=\"\ub354\ubcf4\uae30\",use=\"\uc228\uae30\uae30\",pse=\"\ubd81\uba54\uc774\ucee4 \uc815\ubcf4\",mse=\"\ubcf4\ub108\uc2a4 \ud61c\ud0dd\",fse=\"\ubc30\ub2f9 \ud004\ub7ec\ud2f0\",gse=\"\uc5b8\uc5b4\",hse=\"\ubca0\ud305\",yse=\"\ubca0\ud305 \uc571\",bse=\"\ubc30\ub2f9\ub960\",vse=\"\ubc30\ub2f9\ub960\",wse=\"\uc774\ub3d9\",Cse=\"\uc9c0\uae08 \ubca0\ud305\",Ase=\"\ubc30\ub2f9 \uc6c0\uc9c1\uc784:\",kse=\"\ub0b4 \ucfe0\ud3f0\uc5d0 \ucd94\uac00\",Ise=\"\ub0b4 \ucfe0\ud3f0\uc5d0\uc11c \uc0ad\uc81c\",Tse=\"\uc804\uccb4 \ud1b5\uacc4\",xse=\"\uc6d4\",Ese=\"\uc804\uccb4 \uc608\uce21\",Sse=\"\uc804\uccb4 \uc608\uce21\",Pse=\"\uc801\uc911\",Ose=\"\ubbf8\uc801\uc911\",$se=\"ROI\",Nse=\"\uc9c0\ub09c \ub2ec\uc744 \ubcf4\uc2dc\ub824\uba74 \ud074\ub9ad\ud558\uc138\uc694\",zse=\"\ubaa8\ub4e0 \ud1b5\uacc4\",jse=\"\uc608\uce21\",Mse=\"\uc608\uce21\uc744 \uc81c\ucd9c\ud558\ub824\uba74 \ub85c\uadf8\uc778\ud558\uc138\uc694\",Lse=\"\ub354 \uc774\uc0c1 \ubcc0\uacbd\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4\",Bse=\"\ub0b4 \uc608\uce21\uc5d0 \ucd94\uac00\",Rse=\"\ub0b4 \uc608\uce21 \ubcc0\uacbd\",Dse=\"\ub0b4 \uc608\uce21\uc5d0\uc11c \uc0ad\uc81c\",Hse=\"\ud53d\",Use=\"\uc608\uce21 \ub354\ubcf4\uae30\",Fse=\"\ubaa8\ub4e0 \uc9c0\ub09c \uc608\uce21\",Qse=\"\uc608\uce21\uc774 \uc0ad\uc81c\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\",Gse=\"\uc608\uce21\uc774 \uc800\uc7a5\ub418\uc5c8\uc2b5\ub2c8\ub2e4\",Wse=\"\ucd5c\uadfc 30\uc77c \ub3d9\uc548 \ucd5c\uc18c 5\ucc28\ub840 \uc774\uc0c1 \uc608\uce21\ud55c \ubaa8\ub4e0 \uc0ac\uc6a9\uc790\uac00 \uc5ec\uae30\uc5d0 \ud45c\uc2dc\ub429\ub2c8\ub2e4. \ubaa8\ub4e0 \uc0ac\uc6a9\uc790\ub294 ROI\ub97c \uae30\uc900\uc73c\ub85c \uc815\ub82c\ub429\ub2c8\ub2e4. \ub208 \uc544\uc774\ucf58\uc774 \uc788\ub294 \uc0ac\uc6a9\uc790\ub294 \ud504\ub85c\ud544\uc774 \ube44\uacf5\uac1c\uc774\ubbc0\ub85c \ud314\ub85c\uc6b0\ud558\uac70\ub098 \uc608\uce21\uc744 \ubcfc \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.\",Vse=\"\ucd5c\uadfc 30\uc77c \ub3d9\uc548 \ucd5c\uc18c 5\ucc28\ub840 \uc774\uc0c1 \uc608\uce21\ud55c \ubaa8\ub4e0 \uc0ac\uc6a9\uc790\uac00 \uc5ec\uae30\uc5d0 \ud45c\uc2dc\ub429\ub2c8\ub2e4.\",qse=\"\ud65c\uc131 \uc608\uce21\uc774 1\uac1c \uc774\uc0c1 \uc788\ub294 \ubaa8\ub4e0 \uc0ac\uc6a9\uc790\uac00 \uc5ec\uae30\uc5d0 \ud45c\uc2dc\ub429\ub2c8\ub2e4. ROI\ub97c \uae30\uc900\uc73c\ub85c \uc815\ub82c\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\",Yse=\"Top \uc0ac\uc6a9\uc790\",Jse=\"\uc9c0\uae08 \ud65c\uc131\ud654\",Zse=\"\uc778\uae30 \uc0ac\uc6a9\uc790\",Kse=\"\uc0c1\uc704 \uad6d\uac00\",Xse=\"\uc548\ud0c0\uae5d\uac8c\ub3c4 \uadc0\ud558\uc758 \uae30\uc900\uacfc \uc77c\uce58\ud558\ub294 \ud65c\uc131 \uc0ac\uc6a9\uc790\uac00 \uc5c6\uc2b5\ub2c8\ub2e4. \uc704 \ud544\ud130\uc758 \uac12\uc744 \ubcc0\uacbd\ud558\uc138\uc694.\",eae=\"\ub77c\uc774\ube0c\",tae=\"\ucde8\uc18c\",oae=\"\ub313\uae00\",nae=\"\ub4f1\ub85d\",sae=\"\uc0ad\uc81c\",aae=\"\ubaa8\ub450 \ubcf4\uae30\",rae=\"\uc88b\uc544\uc694\",iae=\"\uc88b\uc544\uc694\ub97c \ub204\ub978\",cae=\"\ub85c\ub529 \uc911\",lae=\"\uc2e0\uace0\",_ae=\"\uc804\uc1a1\",dae=\"\uacf5\uc720\",uae=\"Top\",pae=\"\ubc30\ub2f9\ub960\",mae=\"\uc0c1\ud0dc\",fae=\"\uacbd\uae30\",gae=\"\uc9c0\ubd88\uae08\",hae=\"\uc885\ubaa9\",yae=\"\uad6d\uac00\",bae=\"\uc801\uc911\uc790\",vae=\"\uc544\uc6c3\ub77c\uc774\ud2b8\",wae=\"\ud3c9\uade0\",Cae=\"\ucd5c\uace0\",Aae=\"\uc0c1\uc138\",kae=\"\ub2e4\uc74c\",Iae=\"\uc774\uc804\",Tae=\"\ub85c\uadf8\uc778 \ud544\uc218\",xae=\"\ub85c\uadf8\uc778\",Eae=\"\ud68c\uc6d0\uac00\uc785\",Sae=\"\ubb34\ub8cc\",Pae=\"\ubcf4\ub108\uc2a4\",Oae=\"\uc774\uc804\",$ae=\"\ub808\uc774\",Nae=\"\uc800\uc7a5\",zae=\"\ub354\ubcf4\uae30\",jae=\"\uc228\uae30\uae30\",Mae=\"\ub2ec\ub825\",Lae=\"\uc774 \uacbd\uae30\ub294 \uc885\ub8cc\ub418\uc5c8\uc2b5\ub2c8\ub2e4\",Bae=\"\ud574\ub2f9 \uad6d\uac00\ub294 \uc9c0\uc6d0\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4\",Rae=\"\uc774 \uacbd\uae30\ub294 \uc5f0\uae30\ub418\uc5c8\uc2b5\ub2c8\ub2e4\",Dae=\"\uc774 \uacbd\uae30\ub294 \uc774\ubbf8 \uc2dc\uc791\ub418\uc5c8\uc2b5\ub2c8\ub2e4\",Hae=\"\uc288\uc5b4\ubcb3\",Uae=\"\uc778\ud50c\ub808\uc774 \ubc30\ub2f9\ub960\",Fae=\"\ubca0\ud305 \ud234\",Qae=\"\ubc38\ub958\ubcb3\",Gae=\"\ud310\ub3c8\uc744 \uacc4\uc0b0\ud558\ub824\uba74 \uc5ec\uae30\ub97c \ud074\ub9ad\ud558\uc138\uc694\",Wae=\"\ubc30\ub2f9\ub960\uc744 \ubcf4\uc2dc\ub824\uba74\",Vae=\"\ub85c\uadf8\uc778 \ub610\ub294 \ubb34\ub8cc \ud68c\uc6d0\uac00\uc785\ud558\uc138\uc694!\",qae=\"\uadc0\ud558\ub294 \uc544\uc9c1 \uc608\uce21\uc744 \ud558\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4.\",Yae=\"\uc0ac\uc6a9\uc790 \uc608\uce21\uc740 \uc624\uc988\ud3ec\ud0c8 \uc0ac\uc6a9\uc790\ub4e4\ub85c\ubd80\ud130 \uc218\uc9d1\ub41c \ud53d\uc785\ub2c8\ub2e4.\",Jae=\"\uc608\uce21\uc744 \ucd94\uac00\ud558\ub824\uba74 '\uc608\uce21' \ubc84\ud2bc\uc744 \ud074\ub9ad\ud558\uc2dc\uac70\ub098 \uacbd\uae30\uc0c1\uc138 \uc544\ub798 \ubc31\ubd84\uc728 \ub9c9\ub300\ub97c \ud074\ub9ad\ud558\uc138\uc694\",Zae=\"\ubcf4\uc2dc\ub824\uba74 \ub85c\uadf8\uc778\ud558\uc138\uc694\",Kae=\"{total_counts} \uc911 {outcome_counts} \uc0ac\uc6a9\uc790\uac00 \uc774\uac83\uc744 \uc608\uce21\ud569\ub2c8\ub2e4\",Xae=\"{total_counts} \uc911 {outcome_counts} \uc0ac\uc6a9\uc790\uac00 \uc774 ({percent}%)\ub97c \uc608\uce21\ud569\ub2c8\ub2e4\",ere=\"\uc774\ub97c \uc608\uce21\ud558\ub294 \uc0ac\uc6a9\uc790\uc758 \ud3c9\uade0 ROI\",