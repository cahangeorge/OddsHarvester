=\"\uc0ac\uc774\ud2b8 \uc624\ub958\",p_e=\"\uc77c\ubc18 \ubb38\uc758\",m_e=\"\uad11\uace0\",f_e=\"\ub9c1\ud06c \uad50\ud658\",g_e=\"\ubd81\uba54\uc774\ucee4 \ud53c\ub4dc\ubc31\",h_e=\"\ud14d\uc2a4\ud2b8...\",y_e=\"Oddsportal.com\",b_e=\"Oddsportal\",v_e=\"\uba54\uc2dc\uc9c0\uac00 \uc131\uacf5\uc801\uc73c\ub85c \uc804\uc1a1\ub418\uc5c8\uc2b5\ub2c8\ub2e4\",w_e=\"\ub2d8\uc774 \uc774\uc81c \ub2f9\uc2e0\uc744 \ud314\ub85c\uc6b0\ud569\ub2c8\ub2e4\",C_e=\"\ub2d8\uc774 \uc774\uc81c \ub2f9\uc2e0\uc744 \ud314\ub85c\uc6b0\ud569\ub2c8\ub2e4\",A_e=\"Odds Portal\",k_e=\"\ucfe0\ud3f0\uc774 \uc800\uc7a5\ub418\uc5c8\uc73c\uba70 \uc774\uc81c \uacf5\uac1c\uc801\uc73c\ub85c \uc774\uc6a9 \uac00\ub2a5\ud569\ub2c8\ub2e4. \uc5b8\uc81c\ub4e0\uc9c0 \uc624\ub978\ucabd \ub0b4\ube44\uac8c\uc774\uc158\uc5d0\uc11c \ud655\uc778\ud558\uac70\ub098 \uc544\ub798 \uc635\uc158\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub2e4\ub978 \uc0ac\ub78c\uacfc \uacf5\uc720\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\",I_e=\"\ud2b9\uc815 \ubc30\ub2f9\ub960\uc774 \ub3c4\ub2ec\ud558\uac70\ub098 \ucd08\uacfc\ub420 \uacbd\uc6b0 \uc774\uba54\uc77c \uc54c\ub9bc\uc744 \ubc1b\ub3c4\ub85d \uc120\ud0dd\ud558\uc138\uc694.\",T_e=\"\uc218\uc815 \uc0ac\ud56d\uc774 \uc131\uacf5\uc801\uc73c\ub85c \uc800\uc7a5\ub418\uc5c8\uc73c\uba70 \uc774\uba54\uc77c \uc54c\ub9bc\uc744 \ubc1b\uac8c \ub429\ub2c8\ub2e4.\",x_e='\ucee4\ubba4\ub2c8\ud2f0 \ud53c\ub4dc\uc5d0 \uc624\uc2e0 \uac83\uc744 \ud658\uc601\ud569\ub2c8\ub2e4! \uc5ec\uae30\uc5d0\uc11c \ubaa8\ub4e0 \uc0ac\uc6a9\uc790\uc758 \uc608\uce21\uacfc \ub2f9\uc2e0\uc774 \ud314\ub85c\uc6b0\ud558\ub294 \ubaa8\ub4e0 \uc0ac\uc6a9\uc790\uc758 \uc608\uce21\uc744 \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc608\uce21\uc5d0 \ub313\uae00\uc744 \ub2ec\uac70\ub098 \"\uc88b\uc544\uc694\"\ub97c \ub20c\ub7ec\ubcfc \uc218 \uc788\uc73c\uba70, \uc8fc\ub85c \ub2f9\uc2e0\uc758 \ubca0\ud305\uc5d0 \uc601\uac10\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.',E_e=\"\uc774 \ud544\ub4dc\ub97c \uc791\uc131\ud574\uc8fc