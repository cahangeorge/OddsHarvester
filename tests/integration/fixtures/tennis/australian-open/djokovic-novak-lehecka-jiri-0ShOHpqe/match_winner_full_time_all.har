\uacf5\ud569\ub2c8\ub2e4.\",n_e=\"\uc21c\uc704\",s_e=\"\uc601\uad6d \ubd81\uba54\uc774\ucee4\",a_e=\"\ubc30\ub2f9\uae08 \uccad\uad6c\",r_e=\"\ud604\uc7ac \ud558\ub77d\ud558\ub294 \ubc30\ub2f9\ub960\uc774 \uc5c6\uc2b5\ub2c8\ub2e4!\",i_e=\"\ud604\uc7ac \ucc28\ub2e8\ub41c \ubc30\ub2f9\ub960\uc774 \uc5c6\uc2b5\ub2c8\ub2e4!\",c_e=\"\ub0b4 \ub2e4\uc74c \uacbd\uae30\",l_e=\"\uc774\ub984\uc740 100\uc790 \uc774\ud558\uc5ec\uc57c \ud569\ub2c8\ub2e4.\",__e=\"\uba54\uc2dc\uc9c0\ub294 1000\uc790 \uc774\ud558\uc5ec\uc57c \ud569\ub2c8\ub2e4.\",d_e=\"\uacc4\uc18d\ud558\ub824\uba74 \uc774 \ud544\ub4dc\ub97c \ubc18\ub4dc\uc2dc \uc785\ub825\ud574\uc57c \ud569\ub2c8\ub2e4.\",u_e=\"\uc0ac\uc774\ud2b8 \uc624\ub958\",p_e=\"\uc77c\ubc18 \ubb38\uc758\",m_e=\"\uad11\uace0\",f_e=\"\ub9c1\ud06c \uad50\ud658\",g_e=\"\ubd81\uba54\uc774\ucee4 \ud53c\ub4dc\ubc31\",h_e=\"\ud14d\uc2a4\ud2b8...\",y_e=\"Oddsportal.com\",b_e=\"Oddsportal\",v_e=\"\uba54\uc2dc\uc9c0\uac00 \uc131\uacf5\uc801\uc73c\ub85c \uc804\uc1a1\ub418\uc5c8\uc2b5\ub2c8\ub2e4\",w_e=\"\ub2d8\uc774 \uc774\uc81c \ub2f9\uc2e0\uc744 \ud314\ub85c\uc6b0\ud569\ub2c8\ub2e4\",C_e=\"\ub2d8\uc774 \uc774\uc81c \ub2f9\uc2e0\uc744 \ud314\ub85c\uc6b0\ud569\ub2c8\ub2e4\",A_e=\"Odds Portal\",k_e=\"\ucfe0\ud3f0\uc774 \uc800\uc7a5\ub418\uc5c8\uc73c\uba70 \uc774\uc81c \uacf5\uac1c\uc801\uc73c\ub85c \uc774\uc6a9 \uac00\ub2a5\ud569\ub2c8\ub2e4. \uc5b8\uc81c\ub4e0\uc9c0 \uc624\ub978\ucabd \ub0b4\ube44\uac8c\uc774\uc158\uc5d0\uc11c \ud655\uc778\ud558\uac70\ub098 \uc544\ub798 \uc635\uc158\uc744 \uc0ac\uc6a9\ud558\uc5ec \ub2e4\ub978 \uc0ac\ub78c\uacfc \uacf5\uc720\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\",I_e=\"\ud2b9\uc815 \ubc30\ub2f9\ub960\uc774 \ub3c4\ub2ec\ud558\uac70\ub098 \ucd08\uacfc\ub420 \uacbd\uc6b0 \uc774\uba54\uc77c \uc54c\ub9bc\uc744 \ubc1b\ub3c4\ub85d \uc120\ud0dd\ud558\uc138\uc694.\",T_e=\"\uc218\uc815 \uc0ac\ud56d\uc774 \uc131\uacf5\uc801\uc73c\ub85c \uc800\uc7a5\ub418\uc5c8\uc73c\uba70 \uc774\uba54\uc77c \uc54c\ub9bc\uc744 \ubc1b\uac8c \ub429\ub2c8\ub2e4.\",x_e='\ucee4\ubba4\ub2c8\ud2f0 \ud53c\ub4dc\uc5d0 \uc624\uc2e0 \uac83\uc744 \ud658\uc601\ud569\ub2c8\ub2e4! \uc5ec\uae30\uc5d0\uc11c \ubaa8\ub4e0 \uc0ac\uc6a9\uc790\uc758 \uc608\uce21\uacfc \ub2f9\uc2e0\uc774 \ud314\ub85c\uc6b0\ud558\ub294 \ubaa8\ub4e0 \uc0ac\uc6a9\uc790\uc758 \uc608\uce21\uc744 \ucc3e\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uc608\uce21\uc5d0 \ub313\uae00\uc744 \ub2ec\uac70\ub098 \"\uc88b\uc544\uc694\"\ub97c \ub20c\ub7ec\ubcfc \uc218 \uc788\uc73c\uba70, \uc8fc\ub85c \ub2f9\uc2e0\uc758 \ubca0\ud305\uc5d0 \uc601\uac10\uc744 \uc5bb\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.',E_e=\"\uc774 \ud544\ub4dc\ub97c \uc791\uc131\ud574\uc8fc\uc138\uc694\",S_e=\"\uc774 \uacbd\uae30\uc758 \ubc30\ub2f9\ub960\uc774 \uc81c\uacf5\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4\",P_e=\"\uc0c8 \uba54\uc2dc\uc9c0 \ubcf4\ub0b4\uae30\",O_e=\"\ub2e4\uc74c\uc5d0 \ub300\ud55c \ud478\uc2dc \uc54c\ub9bc \ubc1b\uae30\",$_e=\"\ud314\ub85c\uc6b0\ud55c \uc0ac\uc6a9\uc790\uc758 \uc0c8\ub85c\uc6b4 \uc608\uce21\",N_e=\"\uc0c8\ub85c\uc6b4 \ud314\ub85c\uc6cc\",z_e=\"18+ Play responsibly\",j_e=\"\ubc29\ubb38\ud558\uace0 \ubcf4\ub108\uc2a4 \ubc1b\uae30\",M_e=\"\ubd81\uba54\uc774\ucee4 \ubcf4\uae30\",L_e=\"\uc5d0 \uc0c8\ub85c\uc6b4 \ubd81\uba54\uc774\ucee4 \ub4f1\uc7a5!\",B_e=\"\uac1c\uc778\uc815\ubcf4\ubcf4\ud638 \uc815\ucc45\",R_e=\"laliga\",D_e=\"serie-a\",H_e=\"bundesliga\",U_e=\"ligue-1\",F_e=\"champions-league\",Q_e=\"europa-league\",G_e=\"atp-us-open\",W_e=\"atp-wimbledon\",V_e=\"atp-australian-open\",q_e=\"wta-us-open\",Y_e=\"wta-french-open\",J_e=\"wta-wimbledon\",Z_e=\"wta-australian-open\",K_e=\"nba\",X_e=\"ncaa\",ede=\"super-lig\",tde=\"lnb\",ode=\"bbl\",nde=\"acb\",sde=\"nfl\",ade=\"nhl\",rde=\"mlb\",ide=\"big-bash-league\",cde=\"afl\",lde=\"shl\",_de=\"npb\",dde=\"ipl\",ude=\"saudi-professional-league\",pde=\"world-championship-2026\",mde=\"eredivisie\",fde=\"premier-league\",gde=\"copa-libertadores\",hde=\"euroleague\",yde=\"conference-league\",bde=\"uefa-nations-league\",vde=\"premier-league\",wde=\"atp-french-open\",Cde=\"serie-a-betano\",Ade=\"serie-b-superbet\",kde=\"serie-c\",Ide=\"Impressum\",Tde=\"\ud3c9\uade0 \ub4dd\uc810\",xde=\"\ud3c9\uade0 \uc2e4\uc810\",Ede=\"[[ParticipantName]] \uc758 \ubca0\ud305 \ubc30\ub2f9\ub960, \uacb0\uacfc \ubc0f \uacbd\uae30 \uc77c\uc815\",Sde=\"[[ParticipantName]] \uc758 \uc608\uc815\ub41c \uacbd\uae30 \ubc0f \uacb0\uacfc\",Pde=\"\uacbd\uae30 \uc815\ubcf4 \ubc0f \ubca0\ud305 \uc778\uc0ac\uc774\ud2b8\",Ode=\"\ubc30\ub2f9\ub960, \uc815\ubcf4, \uc0ac\uc2e4 \ubc0f \uc5ed\uc0ac\",$de=\"\ud300 \ud398\uc774\uc9c0\ub85c \uc774\ub3d9\",Nde=\"\ubaa8\ub4e0 \uacb0\uacfc \ubcf4\uae30\",zde=\"\ucd5c\uadfc 6\uacbd\uae30 \uc131\uc801\",jde=\"[[ParticipantName]]\uacfc [[RivalTeam]]\uc758 \ub2e4\uac00\uc624\ub294 \uacbd\uae30\uc5d0 \ub300\ud55c \uc8fc\uc694 \uacbd\uae30\ub825 \ud1b5\uacc4 \ubc0f \ubc30\ud305 \ud655\ub960\uc744 \ud655\uc778\ud558\uc138\uc694. \ucd5c\uadfc \uacb0\uacfc, \ub4dd\uc810 \ucd94\uc138, \uadf8\ub9ac\uace0 \uac00\uc7a5 \uac00\uce58 \uc788\ub294 \ubc30\ub2f9\ub960\uc744 \ucc3e\uc744 \uc218 \uc788\ub294 \uacf3\uc744 \ud3ec\ud568\ud569\ub2c8\ub2e4.\",Mde=\"\ub3c5\uc810 \uc2a4\ud3ec\uce20 \uc18c\uc2dd\uacfc \ud61c\ud0dd\uc744 \ubc1b\uc544\ubcf4\uc138\uc694!\",Lde=\"\uadc0\ud558\uc758 \uc120\ud638\uc5d0 \ub9de\uac8c \uc800\ud76c\uc758 \ub9c8\ucf00\ud305 \ucee4\ubba4\ub2c8\ucf00\uc774\uc158\uc744 \uc870\uc815\ud558\uace0, \uc800\ud76c \ub610\ub294 \uc81c3\uc790\uc758 \uc5c5\ub370\uc774\ud2b8\uc640 \ud61c\ud0dd\uc73c\ub85c \uc5f0\ub77d\ub4dc\ub824\ub3c4 \ub420\uae4c\uc694?\",Bde=\"\ub9c8\ucf00\ud305 \ub3d9\uc758:\",Rde=\"\ub9c8\ucf00\ud305 \ud658\uacbd\uc124\uc815\uc744 \ubcc0\uacbd\ud558\uace0, \uc800\ud76c \ub610\ub294 \uc81c3\uc790\uc758 \ud61c\ud0dd\uc73c\ub85c \uc5f0\ub77d\ub4dc\ub9b4 \uc218 \uc788\ub294\uc9c0 \uad00\ub9ac\ud558\uc138\uc694.\",Dde=\"Oddsportal\uacfc \uc2e0\ub8b0\ud560 \uc218 \uc788\ub294 \ud30c\ud2b8\ub108\ub85c\ubd80\ud130 \ub3c5\uc810 \uc18c\uc2dd\uacfc \ud2b9\ubcc4 \ud61c\ud0dd\uc744 \ubc1b\uace0 \uc2f6\uc2b5\ub2c8\ub2e4.\",Hde=\"\uad6c\ub3c5\uc774 \uc131\uacf5\uc801\uc73c\ub85c \ucde8\uc18c\ub418\uc5c8\uc2b5\ub2c8\ub2e4.\",Ude=\"\ub610\ub294\",Fde=\"\uc9c0\uae08 \ubc1b\uae30\",Qde=\"\ucee8\ub514\uc158\",Gde=\"New Team Page on OddsPortal!\",Wde=\"We created new pages with betting insights, odds, results, and other details about a specific team. You can access it via Match detail, Standings page or Search. Check it out now!\",Vde=\"VISIT A TEAM PAGE\",qde=\"Check it out now!\",Yde=\"\uc2b9\",Jde=\"AI \uacbd\uae30 \uc608\uce21\",Zde=\"\ud655\ub960\",Kde=\"\ud655\ub960\",Xde=\"All Bookies\",eue=\"Classic Bookies\",tue=\"Crypto Bookies\",oue=\"Percentage of matches where both teams scored (counting the last 6 games).\",nue=\"Percentage of matches with over [goals] total goals from the last 6 games.\",sue=\"\uc0c8 \uc0ac\uc6a9\uc790\uba85\",aue=\"This bookmaker doesn\u2019t offer odds for this match\",rue=\"Hide bookmakers without odds\",iue=\"Disfruta al m\u00e1ximo de CuotasAhora.com\",cue=\"Para sacar el m\u00e1ximo partido de nuestro contenido, incluidas las cuotas, por favor, confirma tu edad.\",lue=\"Soy mayor de 18 a\u00f1os\",_ue=\"Soy menor de 18 a\u00f1os\",due=\"\ud3c9\uade0 \ub4dd\uc810\",uue=\"\ud3c9\uade0 \uc2e4\uc810\",pue=\"\ud3c9\uade0 \ub4dd\uc810 \ub7f0\",mue=\"\ud3c9\uade0 \uc2e4\uc810 \ub7f0\",fue=\"\uc9c0\ub09c 6\uacbd\uae30 \uc911 [points]\uc810 \ucd08\uacfc \uacbd\uae30\uc758 \ube44\uc728\",gue=\"\uc9c0\ub09c 6\uacbd\uae30 \uc911 \ucd1d [runs]\ub7f0\uc744 \ucd08\uacfc\ud55c \uacbd\uae30\uc758 \ube44\uc728\",hue=\"\uc154\ud2b8\uc544\uc6c3 \uacbd\uae30\",yue=\"\ud300\uc774 \uc2e4\uc810 0\uc810\uc744 \uae30\ub85d\ud55c \uacbd\uae30\",bue=\"Best odds on your favorite team\",vue=\"[[PROVIDER]] is offering the highest odds ([[ODDS]]) for [[TEAM]] to win their {gamesnumber} upcoming matches, with a strong [[PAYOUT]]% payout.\",wue=\"BET NOW\",Cue=\"The odds above are only average. We want to save you a couple of clicks and show which of the bookmakers offers the best odds so you profit the most.\",Aue=\"OddsPortal\uc758 AI \uc608\uce21!\",kue=\"\uac00\uc7a5 \uc778\uae30 \uc788\ub294 \ub300\ud68c(\uc608: \ud504\ub9ac\ubbf8\uc5b4\ub9ac\uadf8, \ucc54\ud53c\uc5b8\uc2a4\ub9ac\uadf8, \ub77c\ub9ac\uac00)\uc758 \uacbd\uae30\uc5d0\ub294 \ubca0\ud305\uc5d0 \ub3c4\uc6c0\uc774 \ub418\ub294 \uc0c8\ub85c\uc6b4 AI \uae30\ubc18 \uc608\uce21\uc744 \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4. \uc774 \uc608\uce21\uc740 \uacbd\uae30 \uc2dc\uc791 \uc774\ud2c0 \uc804\uc5d0 \uc0dd\uc131\ub418\uba70, \ub9e4\uce58 \uc0c1\uc138 \ud398\uc774\uc9c0\uc5d0\uc11c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc9c0\uae08 \ubc14\ub85c \ud655\uc778\ud574 \ubcf4\uc138\uc694!\",Iue=\"AI \uc608\uce21\uc744 \ud655\uc778\ud558\uc138\uc694\",Tue=\"\ubaa8\ub4e0 \ubca0\ud305\uc5c5\uccb4\",xue=\"\ub9ac\ubdf0 \ubcf4\uae30\",Eue=\"Classic\",Sue=\"Crypto\",Pue=\"you must be logged-in\",Oue=\"Play more effectively thanks to Oddsportal!\",$ue=\"\uc608\uce21\uc744 \uc800\uc7a5\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4\",Nue=\"Mon\",zue=\"Tue\",jue=\"Wed\",Mue=\"Thu\",Lue=\"Fri\",Bue=\"Sat\",Rue=\"Sun\",Due=\"We list most popular matches here. Find the best betting odds and bookmakers offering them easily. Click on any match to view betting odds comparison from all bookmakers. Visit our page for [[sports_betting_bonuses]] today and find the offers that earn you added funds to use on the most popular matches that are coming up.\",Hue=\"\uacbd\uae30 \uc885\ub8cc\",Uue=\"\uc885\ub8cc\",Fue=\"\uc5f0\uc7a5\",Que=\"\uc5f0\uc7a5\uc804 \ud6c4\",Gue=\"\uc2b9\ubd80\ucc28\uae30 \ud6c4\",Wue=\"\uc2b9\ubd80\ucc28\uae30\",Vue=\"\uc5f0\uc7a5\uc804 \ud6c4\",que=\"\uc5f0\uc7a5\",Yue=\"\ucde8\uc18c\ub428\",Jue={profit_uppercase:WH,oddslang_odds:VH,oddsformat_oddslang_formats_1:qH,oddsformat_oddslang_formats_2:YH,oddsformat_oddslang_formats_3:JH,oddsformat_oddslang_formats_4:ZH,oddsformat_oddslang_formats_5:KH,oddsformat_oddslang_formats_6:XH,top_predic